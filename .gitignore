# Jondo.Unity.WebClient .gitignore
# This OVERRIDES repo-level rules that block *.py, *.dll, tools/

# === Unity standard ignores ===
UnityProject/[Ll]ibrary/
UnityProject/[Tt]emp/
UnityProject/[Oo]bj/
UnityProject/[Bb]uild/
UnityProject/[Bb]uilds/
UnityProject/[Ll]ogs/
UnityProject/[Uu]ser[Ss]ettings/
UnityProject/.utmp/

# StreamingAssets rebuilt by RebuildBundlesForWebGL.cs
UnityProject/Assets/StreamingAssets/

# Plugin temp/backup files (not the DLLs themselves)
UnityProject/Assets/Plugins/*.tmp
UnityProject/Assets/Plugins/*.bak
UnityProject/Assets/Plugins/*.bak.*
UnityProject/Assets/Plugins/*_backup*/

# Unity backup directories
UnityProject/_backup*/
UnityProject/Plugins_stubs_backup/

# === Node.js ===
WebServer/node_modules/
WebServer/unity-build/

# === Python ===
__pycache__/
*.pyc

# === .NET build output ===
Tools/*/bin/
Tools/*/obj/

# === FMODUnity git subdir ===
Tools/FMODUnity/.git/

# === Client ===
Cliente 3.6.10.11/

# === playwright-mcp ===
.playwright-mcp/

# === Large excluded files (regenerate per Decompiled/README.md) ===
# decompiled_all.c (964MB) — too large, document Ghidra steps instead
# il2cpp.h, il2cpp_ghidra.h — regenerated by Il2CppDumper

# === FORCE INCLUDE (override repo-level .gitignore) ===
!Tools/
!Tools/**
!*.py
!*.dll
!*.a
!Decompiled/
!Decompiled/**
!Generated/
!Generated/**

# Build & test logs
*.log
scratch_*.txt

WebServer/Build/
WebServer/StreamingAssets/
WebServer/TemplateData/

