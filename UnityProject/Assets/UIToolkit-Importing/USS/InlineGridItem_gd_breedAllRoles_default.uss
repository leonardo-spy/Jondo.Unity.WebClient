#pb_progressBar .extend-progress-bar__background {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
    background-color: rgb(0, 0, 0);
}

#foreground {
    width: 100%;
    height: 100%;
}

.renderstudio-grid-view__item__background:hover:disabled {
    background-color: rgba(204, 204, 204, 0.0627);
}

