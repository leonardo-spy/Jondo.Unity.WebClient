.Common {
    border-color: var( --white_white100);
    color: var( --white_white100);
}

.Uncommon {
    border-color: var( --qualitative_green100);
    color: var( --qualitative_green100);
}

.Rare {
    border-color: var( --qualitative_blue100);
    color: var( --qualitative_blue100);
}

.Epic {
    border-color: var( --qualitative_purple100);
    color: var( --qualitative_purple100);
}

.Legendary {
    border-color: var( --qualitative_orange100);
    color: var( --qualitative_orange100);
}

