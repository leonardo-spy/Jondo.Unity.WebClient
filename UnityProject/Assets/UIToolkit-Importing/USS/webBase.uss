.blueButton {
    background-image: url("/Assets/UI/USSTextures/btn_green_thin_border_disabled.png");
    -unity-background-image-tint-color: rgb(72, 246, 255);
}

.blueButton:hover {
    background-image: url("/Assets/UI/USSTextures/btn_green_thin_border_disabled_over.png");
}

.blueButton:active {
    background-image: url("/Assets/UI/USSTextures/btn_green_thin_border_disabled_pressed.png");
}

.help {
    background-image: url("/Assets/UI/InlineTextures/collectionTab_0_btn_help_normal.png");
}

.help:hover {
    background-image: url("/Assets/UI/USSTextures/btn_help_over.png");
}

.warning {
    background-image: url("/Assets/UI/InlineTextures/breachShop_reward_0_pin_mark_yellow.png");
}

.warning:hover {
    background-image: url("/Assets/UI/InlineTextures/breachShop_reward_0_pin_mark_yellow.png");
}

