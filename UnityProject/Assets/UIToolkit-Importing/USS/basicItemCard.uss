#ctr_itemTexture {
    border-color: var( --highlight_primary100);
    border-width: 2px;
    border-radius: 2px;
}

#lbl_name {
    color: var( --white_white100);
    --labelShadow: var( --dropShadows_light);
    -unity-text-outline-color: var( --black_black50);
    -unity-text-outline-width: 1px;
    -unity-font-style: bold;
}

#inputPrice #textInput_content {
    height: 40px;
}

.NotEnoughKamas {
    color: var( --qualitative_red100);
}

