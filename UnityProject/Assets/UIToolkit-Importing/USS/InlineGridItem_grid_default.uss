#btn_deactivateShortcuts:hover {
    --btn_texture_btn_deactivateShortcutsImgVar: url("/Assets/UI/Themes/darkStone/common/btn_checkbox_normal.png");
}

#btn_deactivateShortcuts {
    --btn_texture_btn_deactivateShortcutsImgVar: url("/Assets/UI/Themes/darkStone/common/btn_checkbox_normal.png");
}

#btn_deactivateShortcuts:active {
    --btn_texture_btn_deactivateShortcutsImgVar: url("/Assets/UI/Themes/darkStone/common/btn_checkbox_normal.png");
}

#btn_deactivateShortcuts:disabled {
    --btn_texture_btn_deactivateShortcutsImgVar: url("/Assets/UI/Themes/darkStone/common/btn_checkbox_normal.png");
}

#btn_deactivateShortcuts:focus {
    --btn_texture_btn_deactivateShortcutsImgVar: url("/Assets/UI/Themes/darkStone/common/btn_checkbox_selected.png");
}

#btn_deactivateShortcuts:focus:hover {
    --btn_texture_btn_deactivateShortcutsImgVar: url("/Assets/UI/Themes/darkStone/common/btn_checkbox_selected.png");
}

#btn_deactivateShortcuts:focus:active {
    --btn_texture_btn_deactivateShortcutsImgVar: url("/Assets/UI/Themes/darkStone/common/btn_checkbox_selected.png");
}

#btn_texture_btn_deactivateShortcuts {
    background-image: var( --btn_texture_btn_deactivateShortcutsImgVar);
}

#btnAssoc:hover {
    --btn_texture_btnAssocImgVar: url("/Assets/UI/USSTextures/btn_green_over.png");
}

#btnAssoc {
    --btn_texture_btnAssocImgVar: url("/Assets/UI/USSTextures/btn_green_normal.png");
}

#btnAssoc:active {
    --btn_texture_btnAssocImgVar: url("/Assets/UI/USSTextures/btn_green_pressed.png");
}

#btnAssoc:disabled {
    --btn_texture_btnAssocImgVar: url("/Assets/UI/USSTextures/btn_green_disabled.png");
}

#btn_texture_btnAssoc {
    background-image: var( --btn_texture_btnAssocImgVar);
}

