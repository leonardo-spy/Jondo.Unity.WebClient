#btn_help:hover {
    --bgTexturebtn_helpImgVar: url("/Assets/UI/USSTextures/subhint_over.png");
}

#btn_help {
    --bgTexturebtn_helpImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_question.png");
}

#btn_help:focus {
    --bgTexturebtn_helpImgVar: url("/Assets/UI/USSTextures/subhint_selected.png");
}

#btn_help:focus:hover {
    --bgTexturebtn_helpImgVar: url("/Assets/UI/USSTextures/subhint_selected.png");
}

#bgTexturebtn_help {
    background-image: var( --bgTexturebtn_helpImgVar);
}

#btn_close:hover {
    --bgTexturebtn_closeImgVar: url("/Assets/UI/USSTextures/btn_close_over.png");
}

#btn_close {
    --bgTexturebtn_closeImgVar: url("/Assets/UI/Themes/darkStone/common/btn_close_normal.png");
}

#btn_close:active {
    --bgTexturebtn_closeImgVar: url("/Assets/UI/USSTextures/btn_close_pressed.png");
}

#btn_close:disabled {
    --bgTexturebtn_closeImgVar: url("/Assets/UI/USSTextures/btn_close_disabled.png");
}

#bgTexturebtn_close {
    background-image: var( --bgTexturebtn_closeImgVar);
}

