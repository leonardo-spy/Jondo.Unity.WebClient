.arrow:hover {
    background-image: url("/Assets/UI/USSTextures/btn_arrow_turn_outside_over.png");
}

.arrow {
    background-image: url("/Assets/UI/USSTextures/btn_arrow_turn_outside_normal.png");
}

.arrow:active {
    background-image: url("/Assets/UI/USSTextures/btn_arrow_turn_outside_pressed.png");
}

.arrow:disabled {
    background-image: url("/Assets/UI/USSTextures/btn_arrow_turn_outside_disabled.png");
}

