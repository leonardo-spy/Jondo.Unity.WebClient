#btn_beta:hover {
    --bgTexturebtn_betaImgVar: url("/Assets/UI/USSTextures/btn_green_small_over.png");
    --iconTexturebtn_betaImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_bug.png");
}

#btn_beta {
    --bgTexturebtn_betaImgVar: url("/Assets/UI/InlineTextures/fighterGridSlot_7_btn_green_small_normal.png");
    --iconTexturebtn_betaImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_bug.png");
}

#btn_beta:active {
    --bgTexturebtn_betaImgVar: url("/Assets/UI/USSTextures/btn_green_small_pressed.png");
    --iconTexturebtn_betaImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_bug.png");
}

#btn_beta:disabled {
    --bgTexturebtn_betaImgVar: url("/Assets/UI/USSTextures/btn_green_small_disabled.png");
    --iconTexturebtn_betaImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_bug.png");
}

#btn_beta:focus {
    --bgTexturebtn_betaImgVar: url("/Assets/UI/USSTextures/btn_green_small_selected.png");
    --iconTexturebtn_betaImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_bug.png");
}

#btn_beta:focus:hover {
    --bgTexturebtn_betaImgVar: url("/Assets/UI/USSTextures/btn_green_small_selectedover.png");
    --iconTexturebtn_betaImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_bug.png");
}

#btn_beta:focus:active {
