    --iconTexturebtn_betaImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_bug.png");
}

#bgTexturebtn_beta {
    background-image: var( --bgTexturebtn_betaImgVar);
}

#iconTexturebtn_beta {
    background-image: var( --iconTexturebtn_betaImgVar);
}

