DofusIcon {
    --tint: true;
}

.unity-collection-view__background {
    height: 0;
    min-height: 0;
    max-height: 0;
}

.unity-collection-view__item--alternative-background:hover:enabled {
    background-color: rgba(0, 0, 0, 0.2);
}

.unity-collection-view__item:hover:enabled {
    background-color: initial;
}

.unity-collection-view:focus:enabled .unity-collection-view__item--selected {
    background-color: initial;
}

.unity-button {
    border-width: 0;
    border-color: transparent;
}

.unity-base-text-field__input {
    border-width: 0;
    border-color: transparent;
    background-color: transparent;
}

.rotate180 {
}

.unity-disabled {
    opacity: 1;
}

.unity-collection-view:focus:enabled .unity-collection-view__item--selected {
    background-color: transparent;
}

.unity-list-view__item:disabled:hover {
    background-color: transparent;
}

