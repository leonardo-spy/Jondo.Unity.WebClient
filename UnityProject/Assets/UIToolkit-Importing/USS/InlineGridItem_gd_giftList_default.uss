#btn_getGift:hover {
    --btn_texture_btn_getGiftImgVar: url("/Assets/UI/USSTextures/btn_green_over.png");
}

#btn_getGift {
    --btn_texture_btn_getGiftImgVar: url("/Assets/UI/USSTextures/btn_green_normal.png");
}

#btn_getGift:active {
    --btn_texture_btn_getGiftImgVar: url("/Assets/UI/USSTextures/btn_green_pressed.png");
}

#btn_getGift:disabled {
    --btn_texture_btn_getGiftImgVar: url("/Assets/UI/USSTextures/btn_green_disabled.png");
}

#btn_texture_btn_getGift {
    background-image: var( --btn_texture_btn_getGiftImgVar);
}

