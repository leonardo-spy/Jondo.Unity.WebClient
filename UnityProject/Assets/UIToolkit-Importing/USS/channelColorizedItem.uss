.combobox__upArrow {
    left: -15px;
}

.combobox__downArrow {
    left: -15px;
}

#lbl_colorChannel {
    top: 3px;
}

#tx_color {
    top: 4px;
}

Button {
    width: 300px;
    height: 25px;
}

.combobox__button {
    width: 295px;
    height: 38px;
    top: -2px;
    left: -2px;
}

.combobox__button > #lbl_colorChannel {
    top: 10px;
}

.combobox__button #tx_color {
    top: 12px;
}

.unity-button {
    background-color: rgba(0, 0, 0, 0);
}

.combobox__item:hover {
    background-color: rgba(160, 160, 160, 0.31);
}

