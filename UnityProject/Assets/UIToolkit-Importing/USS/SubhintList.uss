#btn_refresh:hover {
    --bgTexturebtn_refreshImgVar: url("/Assets/UI/USSTextures/btn_green_small_over.png");
    --iconTexturebtn_refreshImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_reset.png");
}

#btn_refresh {
    --bgTexturebtn_refreshImgVar: url("/Assets/UI/InlineTextures/fighterGridSlot_7_btn_green_small_normal.png");
    --iconTexturebtn_refreshImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_reset.png");
}

#btn_refresh:active {
    --bgTexturebtn_refreshImgVar: url("/Assets/UI/USSTextures/btn_green_small_pressed.png");
    --iconTexturebtn_refreshImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_reset.png");
}

#btn_refresh:disabled {
    --bgTexturebtn_refreshImgVar: url("/Assets/UI/USSTextures/btn_green_small_disabled.png");
    --iconTexturebtn_refreshImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_reset.png");
}

#btn_refresh:focus {
    --bgTexturebtn_refreshImgVar: url("/Assets/UI/USSTextures/btn_green_small_selected.png");
    --iconTexturebtn_refreshImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_reset.png");
}

#btn_refresh:focus:hover {
    --bgTexturebtn_refreshImgVar: url("/Assets/UI/USSTextures/btn_green_small_selectedover.png");
    --iconTexturebtn_refreshImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_reset.png");
}

#btn_refresh:focus:active {
    --bgTexturebtn_refreshImgVar: url("/Assets/UI/USSTextures/btn_green_small_selectedpressed.png");
    --iconTexturebtn_refreshImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_reset.png");
}

#bgTexturebtn_refresh {
    background-image: var( --bgTexturebtn_refreshImgVar);
}

#iconTexturebtn_refresh {
    background-image: var( --iconTexturebtn_refreshImgVar);
}

