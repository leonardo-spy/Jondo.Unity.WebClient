#btn_getForgettableSpellScroll:hover {
    --bgTexturebtn_getForgettableSpellScrollImgVar: url("/Assets/UI/USSTextures/btn_green_small_over.png");
    --iconTexturebtn_getForgettableSpellScrollImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_parchment.png");
}

#btn_getForgettableSpellScroll {
    --bgTexturebtn_getForgettableSpellScrollImgVar: url("/Assets/UI/InlineTextures/fighterGridSlot_7_btn_green_small_normal.png");
    --iconTexturebtn_getForgettableSpellScrollImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_parchment.png");
}

#btn_getForgettableSpellScroll:active {
    --bgTexturebtn_getForgettableSpellScrollImgVar: url("/Assets/UI/USSTextures/btn_green_small_pressed.png");
    --iconTexturebtn_getForgettableSpellScrollImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_parchment.png");
}

#btn_getForgettableSpellScroll:disabled {
    --bgTexturebtn_getForgettableSpellScrollImgVar: url("/Assets/UI/USSTextures/btn_green_small_disabled.png");
    --iconTexturebtn_getForgettableSpellScrollImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_parchment.png");
}

#btn_getForgettableSpellScroll:focus {
    --bgTexturebtn_getForgettableSpellScrollImgVar: url("/Assets/UI/USSTextures/btn_green_small_selected.png");
    --iconTexturebtn_getForgettableSpellScrollImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_parchment.png");
}

#btn_getForgettableSpellScroll:focus:hover {
    --bgTexturebtn_getForgettableSpellScrollImgVar: url("/Assets/UI/USSTextures/btn_green_small_selectedover.png");
    --iconTexturebtn_getForgettableSpellScrollImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_parchment.png");
}

#btn_getForgettableSpellScroll:focus:active {
    --bgTexturebtn_getForgettableSpellScrollImgVar: url("/Assets/UI/USSTextures/btn_green_small_selectedpressed.png");
    --iconTexturebtn_getForgettableSpellScrollImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_parchment.png");
}

#bgTexturebtn_getForgettableSpellScroll {
    background-image: var( --bgTexturebtn_getForgettableSpellScrollImgVar);
}

#iconTexturebtn_getForgettableSpellScroll {
    background-image: var( --iconTexturebtn_getForgettableSpellScrollImgVar);
}

