#container {
    width: auto;
    height: auto;
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.window {
    width: 920px;
    height: 850px;
    flex-grow: 0;
}

.unity-scroll-view__content-container {
    flex-grow: 1;
}

.subHeader {
    width: 880px;
    height: 50px;
    flex-direction: row;
    justify-content: center;
}

.subHeader .unity-button {
    width: 181px;
    height: auto;
    flex-direction: column-reverse;
    align-items: center;
    margin: 0;
    padding: 0;
    padding-bottom: 5px;
    font-size: 16px;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0);
}

.subHeader .unity-button:hover,
.subHeader .unity-button:disabled {
    color: rgb(222, 255, 0);
    opacity: 1;
}

.subHeader .unity-button:disabled .greenLine,
.subHeader .unity-button:disabled .greenArrow {
    visibility: visible;
}

.subHeader .unity-button:enabled .greenLine,
.subHeader .unity-button:enabled .greenArrow {
    visibility: hidden;
}

.greenLine {
    background-image: url("/Assets/UI/Themes/darkStone/common/green_line.png");
    width: 100%;
    height: 3px;
}

.greenArrow {
    background-image: url("/Assets/UI/Themes/darkStone/common/green_arrow.png");
    width: 13px;
    height: 7px;
}

#storageWidth {
    width: 335px;
}

#storage {
    position: absolute;
    top: 25px;
    left: 170px;
}

#subHeader {
    border-bottom-width: 1px;
    border-bottom-color: var( --white_white15);
}

