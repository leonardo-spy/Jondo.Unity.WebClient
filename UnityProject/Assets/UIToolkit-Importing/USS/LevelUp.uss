#btn_close_main:hover {
    --btn_texture_btn_close_mainImgVar: url("/Assets/UI/USSTextures/btn_green_over.png");
}

#btn_close_main {
    --btn_texture_btn_close_mainImgVar: url("/Assets/UI/USSTextures/btn_green_normal.png");
}

#btn_close_main:active {
    --btn_texture_btn_close_mainImgVar: url("/Assets/UI/USSTextures/btn_green_pressed.png");
}

#btn_close_main:disabled {
    --btn_texture_btn_close_mainImgVar: url("/Assets/UI/USSTextures/btn_green_disabled.png");
}

#btn_texture_btn_close_main {
    background-image: var( --btn_texture_btn_close_mainImgVar);
}

#btn_close_main > #text {
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

#decoWindow {
    opacity: 0.065;
    -unity-background-scale-mode: scale-and-crop;
}

#gradientWindow {
    -unity-background-image-tint-color: var( --background_dark100);
}

#gd_new_spells .itemSlot {
    margin-left: 16px;
    flex-shrink: 0;
    flex-grow: 0;
    width: 112px;
    height: 112px;
}

