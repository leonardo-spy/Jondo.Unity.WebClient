.p {
    font-size: 15;
    color: rgb(199, 199, 197);
    -unity-text-align: upper-left;
    -unity-font-definition: url("/Assets/Resources/DefaultFont.asset");
}

.common {
    color: rgb(176, 176, 176);
}

.uncommon {
    color: rgb(82, 174, 63);
}

.rare {
    color: rgb(73, 168, 175);
}

.epic {
    color: rgb(152, 85, 203);
}

.legendary {
    color: rgb(245, 208, 0);
}

.headertitle {
    font-size: 18;
    color: rgb(223, 223, 223);
    -unity-font-style: bold;
    -unity-font-definition: url("/Assets/Resources/DefaultFont.asset");
}

