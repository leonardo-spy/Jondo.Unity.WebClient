.unity-list-view__empty-label {
    display: none;
}

.category #lbl_questLevel {
    display: none;
}

.category #tx_section {
    display: flex;
}

.category #tb_follow {
    display: none;
}

.category #lbl_questNumber {
    display: flex;
}

.quest #tb_follow {
    display: flex;
}

.quest #lbl_questNumber {
    display: none;
}

.category #sectionHeader_button1 {
    display: flex;
}

.quest #sectionHeader_button1 {
    display: none;
}

.quest #sectionHeader_content {
    border-width: 0;
    padding: 0 16px 0 16px;
}

.category #sectionHeader_content {
    padding: 0 16px 0 0;
    border-width: 0;
}

.icon {
    display: none;
}

.quest.completed #tb_follow {
    display: none;
}

.quest.repeatable #tx_repeatable {
    display: flex;
}

.quest.dungeon #tx_dungeon {
    display: flex;
}

.quest.party #tx_party {
    display: flex;
}

