.unity-base-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
    white-space: normal;
    --unity-cursor-color: white;
}

#fieldParent {
    background-image: url("/Assets/UI/Themes/darkStone/common/bg_small_border_dark.png");
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
}

#cbx_login #dropdownButton {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
}

#text {
    left: -10px;
}

.loginButton #loginButton_container {
    width: 100%;
    height: 100%;
    background-image: url("/Assets/UI/USSTextures/bigPlayButtonWhite.png");
}

