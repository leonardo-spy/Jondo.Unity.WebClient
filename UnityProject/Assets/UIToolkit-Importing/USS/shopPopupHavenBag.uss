#btn_buy:hover {
    --btn_texture_btn_buyImgVar: url("/Assets/UI/USSTextures/btn_green_over.png");
}

#btn_buy {
    --btn_texture_btn_buyImgVar: url("/Assets/UI/USSTextures/btn_green_normal.png");
}

#btn_buy:active {
    --btn_texture_btn_buyImgVar: url("/Assets/UI/USSTextures/btn_green_pressed.png");
}

#btn_buy:disabled {
    --btn_texture_btn_buyImgVar: url("/Assets/UI/USSTextures/btn_green_disabled.png");
}

#btn_texture_btn_buy {
    background-image: var( --btn_texture_btn_buyImgVar);
}

