.p {
    font-size: 16px;
    color: rgb(63, 57, 50);
    -unity-text-align: upper-left;
    -unity-font-definition: url("/Assets/Resources/DefaultFont.asset");
}

.smallleftmedium {
    font-size: 15px;
    color: rgb(63, 57, 50);
    -unity-text-align: upper-left;
    -unity-font-definition: url("/Assets/Resources/DefaultFont.asset");
}

.rightbold {
    font-size: 16px;
    color: rgb(63, 57, 50);
    -unity-text-align: upper-right;
    -unity-font-definition: url("/Assets/Resources/DefaultFont.asset");
}

.goodybookletterleft {
    font-size: 21px;
    color: rgb(43, 37, 30);
    -unity-text-align: upper-left;
    -unity-font-definition: url("/Assets/Resources/DefaultFont.asset");
}

.scrolltitle {
    color: var( --documents_brown100);
    -unity-text-align: upper-center;
}

.scrolltext {
    font-size: 16px;
    color: rgb(118, 94, 68);
    -unity-text-align: upper-left;
    padding-right: 5px;
    -unity-font-definition: url("/Assets/Resources/DefaultFont.asset");
}

.scrolllink {
    font-size: 18px;
    color: rgb(222, 255, 0);
    -unity-text-align: upper-center;
    -unity-font-definition: url("/Assets/Resources/DefaultFont.asset");
}

