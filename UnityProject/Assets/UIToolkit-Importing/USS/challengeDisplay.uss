#ctr_reward {
    width: 100%;
    height: 28px;
}

.horizontal {
    flex-direction: row;
}

.horizontal #ctr_challenges {
    flex-direction: row;
}

.horizontal #ctr_reward {
    width: 28px;
    height: 100%;
}

.horizontal #ctr_challenges {
    flex-direction: column;
}

.horizontal #challenge_list {
    flex-direction: row;
}

.horizontal #success_list {
    flex-direction: row;
    padding-top: 0;
    padding-left: 4px;
    border-top-width: 0;
    border-left-width: 1px;
}

.horizontal #ctr_lists {
    flex-direction: row;
}

