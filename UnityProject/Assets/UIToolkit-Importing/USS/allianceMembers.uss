#btn_ava:hover {
    --btn_texture_btn_avaImgVar: url("/Assets/UI/Themes/darkStone/common/btn_checkbox_normal.png");
}

#btn_ava {
    --btn_texture_btn_avaImgVar: url("/Assets/UI/Themes/darkStone/common/btn_checkbox_normal.png");
}

#btn_ava:active {
    --btn_texture_btn_avaImgVar: url("/Assets/UI/Themes/darkStone/common/btn_checkbox_normal.png");
}

#btn_ava:disabled {
    --btn_texture_btn_avaImgVar: url("/Assets/UI/Themes/darkStone/common/btn_checkbox_normal.png");
}

#btn_ava:focus {
    --btn_texture_btn_avaImgVar: url("/Assets/UI/Themes/darkStone/common/btn_checkbox_selected.png");
}

#btn_ava:focus:hover {
    --btn_texture_btn_avaImgVar: url("/Assets/UI/Themes/darkStone/common/btn_checkbox_selected.png");
}

#btn_ava:focus:active {
    --btn_texture_btn_avaImgVar: url("/Assets/UI/Themes/darkStone/common/btn_checkbox_selected.png");
}

#btn_texture_btn_ava {
    background-image: var( --btn_texture_btn_avaImgVar);
}

