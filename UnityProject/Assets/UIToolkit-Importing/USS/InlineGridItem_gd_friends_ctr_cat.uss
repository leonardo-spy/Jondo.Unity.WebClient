#btn_addToList:hover {
    --btn_texture_btn_addToListImgVar: url("/Assets/UI/USSTextures/btn_green_over.png");
}

#btn_addToList {
    --btn_texture_btn_addToListImgVar: url("/Assets/UI/USSTextures/btn_green_normal.png");
}

#btn_addToList:active {
    --btn_texture_btn_addToListImgVar: url("/Assets/UI/USSTextures/btn_green_pressed.png");
}

#btn_addToList:disabled {
    --btn_texture_btn_addToListImgVar: url("/Assets/UI/USSTextures/btn_green_disabled.png");
}

#btn_texture_btn_addToList {
    background-image: var( --btn_texture_btn_addToListImgVar);
}

