#btn_help:hover {
    --bgTexturebtn_helpImgVar: url("/Assets/UI/USSTextures/subhint_over.png");
}

#btn_help {
    --bgTexturebtn_helpImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_question.png");
}

#btn_help:focus {
    --bgTexturebtn_helpImgVar: url("/Assets/UI/USSTextures/subhint_selected.png");
}

#btn_help:focus:hover {
    --bgTexturebtn_helpImgVar: url("/Assets/UI/USSTextures/subhint_selected.png");
}

#bgTexturebtn_help {
    background-image: var( --bgTexturebtn_helpImgVar);
}

