#btn_close_administrablePopup:hover {
    --bgTexturebtn_close_administrablePopupImgVar: url("/Assets/UI/USSTextures/btn_close_over.png");
}

#btn_close_administrablePopup {
    --bgTexturebtn_close_administrablePopupImgVar: url("/Assets/UI/Themes/darkStone/common/btn_close_normal.png");
}

#btn_close_administrablePopup:active {
    --bgTexturebtn_close_administrablePopupImgVar: url("/Assets/UI/USSTextures/btn_close_pressed.png");
}

#btn_close_administrablePopup:disabled {
    --bgTexturebtn_close_administrablePopupImgVar: url("/Assets/UI/USSTextures/btn_close_disabled.png");
}

#bgTexturebtn_close_administrablePopup {
    background-image: var( --bgTexturebtn_close_administrablePopupImgVar);
}

