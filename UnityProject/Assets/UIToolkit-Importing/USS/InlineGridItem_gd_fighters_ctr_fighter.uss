#btn_seeMore:hover {
    --bgTexturebtn_seeMoreImgVar: url("/Assets/UI/USSTextures/btn_green_small_over.png");
    --iconTexturebtn_seeMoreImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_plus.png");
}

#btn_seeMore {
    --bgTexturebtn_seeMoreImgVar: url("/Assets/UI/InlineTextures/fighterGridSlot_7_btn_green_small_normal.png");
    --iconTexturebtn_seeMoreImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_plus.png");
}

#btn_seeMore:active {
    --bgTexturebtn_seeMoreImgVar: url("/Assets/UI/USSTextures/btn_green_small_pressed.png");
    --iconTexturebtn_seeMoreImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_plus.png");
}

#btn_seeMore:disabled {
    --bgTexturebtn_seeMoreImgVar: url("/Assets/UI/USSTextures/btn_green_small_disabled.png");
    --iconTexturebtn_seeMoreImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_plus.png");
}

#btn_seeMore:focus {
    --bgTexturebtn_seeMoreImgVar: url("/Assets/UI/USSTextures/btn_green_small_selected.png");
    --iconTexturebtn_seeMoreImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_plus.png");
}

#btn_seeMore:focus:hover {
    --bgTexturebtn_seeMoreImgVar: url("/Assets/UI/USSTextures/btn_green_small_selectedover.png");
    --iconTexturebtn_seeMoreImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_plus.png");
}

#btn_seeMore:focus:active {
    --bgTexturebtn_seeMoreImgVar: url("/Assets/UI/USSTextures/btn_green_small_selectedpressed.png");
    --iconTexturebtn_seeMoreImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_plus.png");
}

#bgTexturebtn_seeMore {
    background-image: var( --bgTexturebtn_seeMoreImgVar);
}

#iconTexturebtn_seeMore {
    background-image: var( --iconTexturebtn_seeMoreImgVar);
}

