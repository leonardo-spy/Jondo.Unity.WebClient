.scrollbarPadding > * > .unity-scroll-view__content-and-vertical-scroll-container {
    padding-right: 18px;
}

.scrollbarPadding > .unity-scroll-view__content-and-vertical-scroll-container {
    padding-right: 18px;
}

.base #npcDialogBubble {
    -unity-background-image-tint-color: var( --background_dark100);
}

#ctr_npcAnswer {
    -unity-background-image-tint-color: var( --background_dark100);
}

#lbl_npcName {
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
    --labelShadow: "0px 2px rgba(0,0,0,0.15)";
}

#lbl_playerName {
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
    --labelShadow: "0px 2px rgba(0,0,0,0.2)";
}

.base#tx_background {
    -unity-background-image-tint-color: var( --background_dark100);
}

#tx_outline {
    background-image: url("/Assets/UI/USSTextures/borderDialogPnj.png");
    -unity-background-image-tint-color: var( --white_white100);
}

.base#encoche {
    -unity-background-image-tint-color: var( --background_dark100);
}

#tx_backgroundReplies {
    background-image: url("/Assets/UI/USSTextures/bgDialogPnj.png");
    -unity-background-image-tint-color: var( --background_dark100);
}

#tx_outlineReplies {
    background-image: url("/Assets/UI/USSTextures/borderDialogPnj.png");
    -unity-background-image-tint-color: var( --highlight_primary100);
}

#lbl_text {
    -unity-font-style: normal;
}

.bold#lbl_text {
    -unity-font-style: bold;
}

.baseDialog #tx_background {
    background-image: url("/Assets/UI/USSTextures/bgDialogPnj.png");
    -unity-background-image-tint-color: var( --background_dark100);
}

.baseDialog #encocheBorder {
    -unity-background-image-tint-color: var( --white_white100);
}

.baseDialog #tx_headerDeco1 {
    background-image: url("/Assets/UI/USSTextures/decoDefault.png");
}

.baseDialog #tx_headerDeco2 {
    background-image: url("/Assets/UI/USSTextures/decoDefault.png");
}

.baseDialog #tx_header {
    background-image: url("/Assets/UI/USSTextures/headerDialog.png");
}

