}

.arrow {
    background-image: url("/Assets/UI/InlineTextures/expeditions_7_btn_arrow_pagination_normal.png");
}

.arrow:active {
    background-image: url("/Assets/UI/USSTextures/btn_arrow_pagination_pressed.png");
}

.arrow:disabled {
    background-image: url("/Assets/UI/USSTextures/btn_arrow_pagination_disabled.png");
}

#tx_nextRewardTooltip:hover {
    background-image: url("/Assets/UI/USSTextures/btn_help_over.png");
}

#tx_nextRewardTooltip {
    background-image: url("/Assets/UI/InlineTextures/collectionTab_0_btn_help_normal.png");
}

#tx_nextRewardTooltip {
    background-image: url("/Assets/UI/InlineTextures/collectionTab_0_btn_help_normal.png");
}

.search-field__search-button {
    display: none;
}

#gd_gift .renderstudio-grid-view__item:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

#gd_gift .renderstudio-grid-view__item--alternative-background:hover {
