.p {
    font-size: 16px;
    color: rgb(199, 199, 197);
    -unity-text-align: upper-left;
    -unity-font-definition: url("/Assets/Resources/DefaultFont.asset");
}

.endbutton {
    font-size: 15px;
    color: rgb(47, 47, 37);
    -unity-text-align: upper-center;
    -unity-font-definition: url("/Assets/Resources/DefaultFont.asset");
}

.skip {
    font-size: 14px;
    color: rgb(109, 109, 109);
    -unity-font-style: italic;
    -unity-text-align: upper-left;
    -unity-font-definition: url("/Assets/Resources/DefaultFont.asset");
}

.skip:hover {
    font-size: 14px;
    color: rgb(255, 255, 255);
    -unity-text-align: upper-left;
    -unity-font-definition: url("/Assets/Resources/DefaultFont.asset");
}

