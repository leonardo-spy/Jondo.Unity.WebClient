.endingAchievementsItem#ctr_card {
    background-color: var( --buttons_buttonSecondary);
}

.endingAchievementsItem#ctr_card:hover {
    background-color: var( --buttons_buttonSecondaryHover);
}

.endingAchievementsItem#ctr_card:active {
    background-color: var( --buttons_buttonSecondaryPressed);
}

.endingAchievementsItem #ctr_header {
    background-color: var( --black_black10);
}

.endingAchievementsItem #ctr_reward {
    background-color: var( --black_black10);
}

