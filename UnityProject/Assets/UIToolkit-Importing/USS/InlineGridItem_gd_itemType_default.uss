.itemType > .unity-toggle__input {
    background-image: url("/Assets/UI/Themes/darkStone/texture/slot/slot_dark_background_empty.png");
    width: 50px;
    height: 50px;
    flex-grow: 1;
}

.itemType > .unity-toggle__input:hover {
    background-image: url("/Assets/UI/USSTextures/slot_inventory_over.png");
}

.itemType > .unity-toggle__input:checked {
    background-image: url("/Assets/UI/USSTextures/slot_inventory_selected.png");
}

