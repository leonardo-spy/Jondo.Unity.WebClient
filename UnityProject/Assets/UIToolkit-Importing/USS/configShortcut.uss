.configShortcut {
    width: 780px;
    height: auto;
    flex-direction: column;
    align-items: center;
}

.configShortcut .block {
    width: 765px;
    height: 60px;
}

.configShortcut .block .unity-label {
    width: 320px;
    position: absolute;
    left: 30px;
}

.configShortcut .combobox {
    width: 400px;
    height: 38px;
    left: 345px;
    top: 3px;
}

.configShortcut .unity-imgui-container {
    width: 15px;
    height: 15px;
}

#gridBackground {
    width: 780px;
    height: 370px;
    background-image: url("/Assets/UI/Themes/darkStone/common/bg_small_border_light.png");
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 11;
    -unity-slice-bottom: 10;
    padding: 9px;
    margin-top: 5px;
    margin-bottom: 5px;
}

#grid {
    width: 100%;
    height: 100%;
}

.configShortcut > .unity-button {
    width: 365px;
    height: 23px;
    -unity-font-style: bold;
}

.shortcutLine {
    width: 755px;
    height: 35px;
    flex-direction: row;
    align-items: center;
}

.shortcutLine > .unity-label {
    width: 460px;
    padding-left: 10px;
}

.shortcutLine > #inputArea {
    align-items: flex-start;
}

.shortcutLine .greenButton {
    -unity-font-style: bold;
    width: 260px;
    height: 31px;
}

.popup .window {
    width: 500px;
    height: 380px;
    flex-grow: 0;
}

.popup .content {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: space-around;
    padding: 2%;
    font-size: 15px;
    color: rgb(47, 47, 37);
    -unity-text-align: middle-center;
}

.popup .block {
    width: 440px;
    height: 120px;
    align-items: center;
    flex-grow: 0;
}

.popup .lblShortcut {
    background-color: rgba(255, 255, 255, 0);
    width: 300px;
    height: 45px;
    background-image: url("/Assets/UI/Themes/darkStone/common/bg_small_border_light.png");
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    justify-content: flex-start;
    align-items: center;
    flex-direction: row;
}

.popup .lblShortcut > .unity-label {
    width: 255px;
    left: 5px;
}

.popup .lblShortcut > .unity-button {
    width: 26px;
    height: 26px;
    align-items: center;
    justify-content: center;
}

.popup .lblShortcut > .unity-button > VisualElement {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    background-image: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_cross.png");
}

.popup .bottom {
    width: 445px;
    height: 80px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.popup .bottom > VisualElement {
    height: 100%;
    width: 80px;
}

.popup .bottom > .greenButton {
    width: 150px;
    height: 31px;
}

.popup .bottom > .unity-button {
    width: 120px;
    height: 31px;
}

.popup .bottom .greenunderline_p {
    background-color: rgba(0, 0, 0, 0);
}

