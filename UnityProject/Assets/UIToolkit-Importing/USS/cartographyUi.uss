#ctr_close {
    background-color: var( --background_medium90);
    border-radius: 2px;
    padding: 4px;
}

#gd_searchResults ScrollView {
    flex-grow: 0;
}

.quantityColor {
    border-width: 1px;
    border-color: var( --white_white80);
    border-radius: 2px;
}

#lbl_displayAll {
    color: var( --highlight_secondary100);
}

#lbl_displayAll.Hover {
    color: var( --white_white80);
}

#tx_displayAll {
    -unity-background-image-tint-color: var( --highlight_secondary100);
}

#tx_displayAll.Hover {
    -unity-background-image-tint-color: var( --white_white80);
}

