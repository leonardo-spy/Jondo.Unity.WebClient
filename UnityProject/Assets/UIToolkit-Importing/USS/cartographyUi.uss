.unity-content {
    margin: 0;
}

.unity-collection-view__item--selected {
    background-color: rgba(204, 204, 204, 0.3);
}

.unity-collection-view__item:hover {
    background-color: rgba(204, 204, 204, 0.2);
}

.unity-list-view__empty-label {
    display: none;
}

.filterButton:hover {
    background-color: rgba(0, 0, 0, 0.25);
}

#dropdownButton {
    margin: 0;
}

#btn_sortConquests:hover {
    --bgTexturebtn_sortConquestsImgVar: url("/Assets/UI/USSTextures/btn_green_small_over.png");
    --iconTexturebtn_sortConquestsImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_filter.png");
}

