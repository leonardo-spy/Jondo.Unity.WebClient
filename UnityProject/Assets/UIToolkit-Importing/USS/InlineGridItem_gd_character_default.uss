#tx_bin {
    background-image: url("/Assets/UI/USSTextures/icon_bin_normal.png");
}

#tx_bin:active {
    background-image: url("/Assets/UI/USSTextures/icon_bin_over.png");
}

#tx_bin:hover {
    background-image: url("/Assets/UI/USSTextures/icon_bin_over.png");
}

#tx_bin:focus:active {
    background-image: url("/Assets/UI/USSTextures/icon_bin_over.png");
}

#tx_bin:focus:hover {
    background-image: url("/Assets/UI/USSTextures/icon_bin_over.png");
}

#btn_gridCharacter:focus {
    background-color: red;
}

