#btn_icon:checked {
    --unity-checkmarkImgVar: url("/Assets/UI/Themes/darkStone/texture/slot/selected.png");
    --tx_selected_arrowDisplay: url("/Assets/UI/InlineTextures/InlineGridItem_gd_breed_default_1_cursorCharacterChoice.png");
}

#btn_icon .unity-radio-button__checkmark {
    background-image: var( --unity-checkmarkImgVar);
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: white;
    width: 56px;
    height: 56px;
    border-width: 0;
    display: flex;
    border-radius: 0;
}

#btn_icon .unity-radio-button__input {
    width: 56px;
    height: 56px;
    display: flex;
}

#btn_icon .unity-radio-button__checkmark-background {
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 0;
    padding: 0;
    width: 56px;
    height: 56px;
    display: flex;
}

#tx_selected_arrow {
    background-image: var( --tx_selected_arrowDisplay);
    -unity-background-image-tint-color: white;
    display: flex;
}

