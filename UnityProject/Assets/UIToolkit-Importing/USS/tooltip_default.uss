.p {
    font-size: 15;
    color: rgb(199, 199, 197);
    -unity-text-align: upper-left;
    -unity-font-definition: url("/Assets/Resources/DefaultFont.asset");
}

.subtitle {
    font-size: 16;
    color: rgb(255, 255, 255);
}

.left_p {
    -unity-text-align: upper-left;
}

.right_p {
    -unity-text-align: upper-right;
}

.center_p {
    -unity-text-align: upper-center;
}

.rightheader_p {
    font-size: 17;
    color: rgb(255, 255, 255);
    -unity-text-align: upper-right;
}

.header_p {
    font-size: 17;
    color: rgb(255, 255, 255);
}

.description_p {
    color: rgb(230, 137, 61);
}

.subtitle_p {
    font-size: 16;
    color: rgb(223, 223, 223);
}

.bonus_p {
    color: rgb(109, 178, 19);
}

.malus_p {
    color: rgb(208, 72, 58);
}

.malusblack_p {
    color: rgb(0, 0, 0);
}

.text {
    font-size: 15px;
    color: rgb(199, 199, 197);
    -unity-text-align: upper-left;
    -unity-font-definition: url("/Assets/Resources/DefaultFont.asset");
}

.quote {
    font-size: 15px;
    -unity-font-style: italic;
    color: rgb(157, 157, 156);
    -unity-font-definition: url("/Assets/Resources/DefaultFont.asset");
}

