.scroll_btn_close:hover {
    background-image: url("/Assets/UI/USSTextures/icon_crossDoc_over.png");
}

.scroll_btn_close {
    background-image: url("/Assets/UI/USSTextures/icon_crossDoc_normal.png");
}

#btn_previous:hover {
    background-image: url("/Assets/UI/USSTextures/icon_arrowDoc_over.png");
}

#btn_previous {
    background-image: url("/Assets/UI/USSTextures/icon_arrowDoc_normal.png");
}

#btn_previous:disabled {
    background-image: url("/Assets/UI/USSTextures/icon_arrowDoc_inactive.png");
}

#btn_next:hover {
    background-image: url("/Assets/UI/USSTextures/icon_arrowDoc_over.png");
}

#btn_next {
    background-image: url("/Assets/UI/USSTextures/icon_arrowDoc_normal.png");
}

#btn_next:disabled {
    background-image: url("/Assets/UI/USSTextures/icon_arrowDoc_inactive.png");
}

