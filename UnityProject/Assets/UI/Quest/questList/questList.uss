.quest-title {
    font-size: 18px;
    border-width: 1px;
    --text-style: "title_medium";
    color: var( --white_white100);
    --labelShadow: var( --dropShadows_light);
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var( --black_black25);
}

.questobjective {
    color: var( --white_white100);
    --text-style: "textShort_mediumRegular";
}

.questlevel_p {
    font-size: 14px;
    -unity-text-align: upper-right;
}

