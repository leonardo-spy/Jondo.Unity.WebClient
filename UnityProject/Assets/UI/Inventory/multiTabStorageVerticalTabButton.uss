.multiTabStorageButtonBackground-normal {
    background-image: url("/Assets/UI/Themes/darkStone/common/tab_right_normal.png");
}

.multiTabStorageButtonBackground-normal:hover {
    background-image: url("/Assets/UI/Themes/darkStone/common/tab_right_over.png");
}

.multiTabStorageButtonBackground-normal:disabled {
    background-image: url("/Assets/UI/Themes/darkStone/common/tab_right_disabled.png");
}

.multiTabStorageButtonBackground-selected {
    background-image: url("/Assets/UI/Themes/darkStone/common/tab_right_selected.png");
}

.multiTabStorageButtonBackground-selected:hover {
    background-image: url("/Assets/UI/Themes/darkStone/common/tab_right_selected.png");
}

