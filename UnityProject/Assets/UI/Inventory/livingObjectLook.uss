#btn_lookOk:hover {
    --btn_texture_btn_lookOkImgVar: url("/Assets/UI/USSTextures/btn_green_over.png");
}

#btn_lookOk {
    --btn_texture_btn_lookOkImgVar: url("/Assets/UI/USSTextures/btn_green_normal.png");
}

#btn_lookOk:active {
    --btn_texture_btn_lookOkImgVar: url("/Assets/UI/USSTextures/btn_green_pressed.png");
}

#btn_lookOk:disabled {
    --btn_texture_btn_lookOkImgVar: url("/Assets/UI/USSTextures/btn_green_disabled.png");
}

#btn_texture_btn_lookOk {
    background-image: var( --btn_texture_btn_lookOkImgVar);
}

#btn_help:hover {
    --bgTexturebtn_helpImgVar: url("/Assets/UI/USSTextures/subhint_over.png");
}

#btn_help {
    --bgTexturebtn_helpImgVar: url("/Assets/UI/Themes/darkStone/texture/btnIcon/btnIcon_question.png");
}

#btn_help:focus {
    --bgTexturebtn_helpImgVar: url("/Assets/UI/USSTextures/subhint_selected.png");
}

#btn_help:focus:hover {
    --bgTexturebtn_helpImgVar: url("/Assets/UI/USSTextures/subhint_selected.png");
}

#bgTexturebtn_help {
    background-image: var( --bgTexturebtn_helpImgVar);
}

#btn_closeLook:hover {
    --bgTexturebtn_closeLookImgVar: url("/Assets/UI/USSTextures/btn_close_over.png");
}

#btn_closeLook {
    --bgTexturebtn_closeLookImgVar: url("/Assets/UI/Themes/darkStone/common/btn_close_normal.png");
}

#btn_closeLook:active {
    --bgTexturebtn_closeLookImgVar: url("/Assets/UI/USSTextures/btn_close_pressed.png");
}

#btn_closeLook:disabled {
    --bgTexturebtn_closeLookImgVar: url("/Assets/UI/USSTextures/btn_close_disabled.png");
}

#bgTexturebtn_closeLook {
    background-image: var( --bgTexturebtn_closeLookImgVar);
}

