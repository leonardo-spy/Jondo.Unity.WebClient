.dofus-button {
    background-image: url("/Assets/UI/USSTextures/btn_green_thin_border_disabled.png");
    background-color: transparent;
    border-color: transparent;
}

.dofus-button:hover {
    background-image: url("/Assets/UI/USSTextures/btn_green_thin_border_disabled_over.png");
    background-color: transparent;
}

.dofus-button:active {
    background-image: url("/Assets/UI/USSTextures/btn_green_thin_border_disabled_pressed.png");
    background-color: transparent;
}

.dofus-button:disabled {
    background-image: url("/Assets/UI/USSTextures/btn_green_small_grey.png");
    background-color: transparent;
}

.dofus-button--selected {
    background-image: url("/Assets/UI/USSTextures/btn_green_normal.png");
    background-color: transparent;
    border-color: transparent;
}

.dofus-button--selected:hover {
    background-image: url("/Assets/UI/USSTextures/btn_green_over.png");
    background-color: transparent;
}

.dofus-button--selected:active {
    background-image: url("/Assets/UI/USSTextures/btn_green_pressed.png");
    background-color: transparent;
}

.dofus-button--selected:disabled {
    background-image: url("/Assets/UI/USSTextures/btn_green_disabled.png");
    background-color: transparent;
}

