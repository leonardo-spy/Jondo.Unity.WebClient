.renderstudio-grid-view__row {
    flex-shrink: 0;
}

.renderstudio-grid-view__dummy-item {
    background-image: url("/Assets/UI/Themes/darkStone/texture/slot/slot_dark_background_empty.png");
}

.renderstudio-grid-view__dummy-item:hover {
    background-image: url("/Assets/UI/Themes/darkStone/texture/slot/slot_dark_background_empty.png");
}

.empty {
    background-image: url("/Assets/UI/Themes/darkStone/texture/slot/slot_dark_background_empty.png");
}

.itemSlot__effect {
    width: 100%;
    height: 100%;
    position: absolute;
}

.itemSlot__ctr-timer {
    position: absolute;
    width: 100%;
    height: 100%;
    padding-left: 3px;
    padding-right: 3px;
    padding-top: 3px;
    padding-bottom: 3px;
}

.itemSlot__timer {
    background-color: rgba(101, 101, 101, 0.5);
    width: 100%;
    height: 100%;
}

.itemSlot__empty-background-purple {
    background-image: url("/Assets/UI/Themes/darkStone/texture/slot/emptySlot_purple.png");
}

.itemSlot--image-none {
    background-image: none;
}

.itemSlot__special-effect {
    background-image: url("/Assets/UI/Themes/darkStone/texture/slot/specialSlot.png");
    background-color: transparent;
}

