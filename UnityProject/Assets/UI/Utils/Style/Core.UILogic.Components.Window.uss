.window {
    flex-shrink: 0;
    flex-grow: 0;
}

.window-notitle__container-background {
    position: absolute;
    width: 100%;
    height: 100%;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 20px;
    padding-bottom: 24px;
}

.window__container-background {
    flex-shrink: 1;
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 100%;
    padding-left: 14px;
    padding-right: 14px;
    padding-bottom: 22px;
    padding-top: 8px;
}

.window__background {
    flex-shrink: 1;
    flex-grow: 1;
    background-image: url("/Assets/UI/USSTextures/window_green_background.png");
}

.window-notitle__container-border {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 100%;
}

.window__container-border {
    position: absolute;
    width: 100%;
    height: 100%;
    padding-top: 8px;
}

.window-notitle__border {
    flex-shrink: 1;
    flex-grow: 1;
    background-image: url("/Assets/UI/USSTextures/window_border_popup_bottom.png");
    padding-right: 20px;
    padding-left: 20px;
    padding-top: 18px;
    padding-bottom: 24px;
    -unity-slice-left: 55;
    -unity-slice-top: 40;
    -unity-slice-right: 55;
    -unity-slice-bottom: 40;
}

.window__border {
    flex-shrink: 1;
    flex-grow: 1;
    background-image: url("/Assets/UI/USSTextures/window_border_bottom.png");
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 0;
    padding-bottom: 26px;
    -unity-slice-left: 50;
    -unity-slice-top: 80;
    -unity-slice-right: 50;
    -unity-slice-bottom: 72;
    margin-top: 37px;
}

.window-notitle__corner {
    position: absolute;
    width: 46px;
    height: 47px;
    right: 19px;
    top: 18px;
    visibility: visible;
    opacity: 1;
    background-image: url("/Assets/UI/USSTextures/block_corner_popup.png");
    align-items: center;
    justify-content: center;
    padding-left: 10px;
    padding-bottom: 12px;
}

.window-notitle__close-button {
    --closeButton_texture: url("/Assets/UI/Themes/darkStone/common/btn_close_normal.png");
    flex-shrink: 0;
    flex-grow: 1;
    background-image: var( --closeButton_texture);
    width: 30px;
    height: 25px;
    background-color: rgba(88, 88, 88, 0);
    border-width: 0;
    border-radius: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.window-notitle__close-button:hover {
    --closeButton_texture: url("/Assets/UI/USSTextures/btn_close_over.png");
    background-color: rgba(0, 0, 0, 0);
}

.window-notitle__close-button:active {
    --closeButton_texture: url("/Assets/UI/USSTextures/btn_close_pressed.png");
    background-color: rgba(0, 0, 0, 0);
}

.window-notitle__close-button:disabled {
    --closeButton_texture: url("/Assets/UI/USSTextures/btn_close_disabled.png");
    background-color: rgba(0, 0, 0, 0);
}

.window__container-title-bar {
    position: relative;
    width: 100%;
    height: 45px;
    flex-direction: row;
    margin-left: 3px;
    padding-right: 8px;
    background-image: url("/Assets/UI/USSTextures/window_border_top.png");
    -unity-slice-left: 20;
    -unity-slice-right: 20;
    flex-shrink: 0;
}

.window__title-bar-right {
    position: absolute;
    top: 1px;
    right: 8px;
    width: 38px;
    height: 100%;
    background-image: url("/Assets/UI/USSTextures/window_border_top_right.png");
}

.window__title-bar-headline {
    flex-shrink: 0;
    flex-grow: 1;
    margin-top: 10px;
    margin-bottom: 4px;
    padding-left: 0;
    padding-right: 0;
    -unity-text-align: middle-center;
    visibility: visible;
    opacity: 100;
    margin-left: 15px;
    margin-right: 15px;
    padding-top: 0;
    padding-bottom: 0;
    -unity-font-style: bold;
    -unity-font-definition: url("/Assets/Resources/DefaultFont.asset");
    font-size: 22px;
    color: rgb(248, 205, 1);
    text-shadow: 2px 2px 0 black;
}

.window__title-bar-no-headline {
    visibility: hidden;
    opacity: 0;
}

.window__title-bar-icon-background {
    position: absolute;
    left: 10px;
    top: -5px;
    width: 147px;
    height: 53px;
    background-image: url("/Assets/UI/USSTextures/window_border_icon_background.png");
}

.window__title-bar-container-icon {
    flex-shrink: 1;
    flex-grow: 1;
    left: 12px;
    justify-content: space-around;
    width: 50px;
    height: 50px;
}

.window__title-bar-icon {
    flex-grow: 1;
}

.window__title-bar-container-buttons {
    position: absolute;
    width: 100%;
    height: 100%;
    flex-direction: row-reverse;
    justify-content: flex-start;
    align-items: center;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 8px;
    padding-bottom: 3px;
}

.window__close-button {
    --closeButton_texture: url("/Assets/UI/Themes/darkStone/common/btn_close_normal.png");
    flex-shrink: 0;
    flex-grow: 0;
    background-image: var( --closeButton_texture);
    width: 22px;
    height: 22px;
    background-color: rgba(88, 88, 88, 0);
    border-width: 0;
    border-radius: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.window__close-button:hover {
    --closeButton_texture: url("/Assets/UI/USSTextures/btn_close_over.png");
    background-color: rgba(0, 0, 0, 0);
}

.window__close-button:active {
    --closeButton_texture: url("/Assets/UI/USSTextures/btn_close_pressed.png");
    background-color: rgba(0, 0, 0, 0);
}

.window__close-button:disabled {
    --closeButton_texture: url("/Assets/UI/USSTextures/btn_close_disabled.png");
    background-color: rgba(0, 0, 0, 0);
}

.window__help-button {
    --helpButton_texture: url("/Assets/UI/InlineTextures/collectionTab_0_btn_help_normal.png");
    flex-shrink: 0;
    flex-grow: 0;
    background-image: var( --helpButton_texture);
    width: 22px;
    height: 22px;
    background-color: rgba(88, 88, 88, 0);
    border-width: 0;
    border-radius: 0;
}

.window__help-button:hover {
    --helpButton_texture: url("/Assets/UI/USSTextures/btn_help_over.png");
    background-color: rgba(0, 0, 0, 0);
}

.window__help-button:active {
    --helpButton_texture: url("/Assets/UI/USSTextures/btn_help_pressed.png");
    background-color: rgba(0, 0, 0, 0);
}

.window__help-button:disabled {
    --helpButton_texture: url("/Assets/UI/USSTextures/btn_help_disabled.png");
    background-color: rgba(0, 0, 0, 0);
}

.window__content {
    flex-grow: 1;
}

.window__container_content {
    padding-left: 19px;
    padding-right: 19px;
    padding-bottom: 25px;
    flex-grow: 1;
}

.window-notitle__container_content {
    padding-left: 25px;
    padding-right: 25px;
    padding-top: 25px;
    padding-bottom: 25px;
}

.window__modal_background {
    background-color: rgba(0, 0, 0, 0.5);
}

