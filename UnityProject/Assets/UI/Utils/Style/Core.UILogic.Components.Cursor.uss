.dofus-cursor-link {
    cursor: url("/Assets/UI/Themes/darkStone/cursor/aero_link.png") 15 0;
}

.dofus-cursor-beam {
    cursor: url("/Assets/UI/Themes/darkStone/cursor/beam.png") 24 24;
}

.dofus-cursor-move {
    cursor: url("/Assets/UI/Themes/darkStone/cursor/aero_move.png") 21 21;
}

.dofus-cursor-size_nesw {
    cursor: url("/Assets/UI/Themes/darkStone/cursor/aero_nesw.png") 15 15;
}

.dofus-cursor-size_nwse {
    cursor: url("/Assets/UI/Themes/darkStone/cursor/aero_nwse.png") 15 15;
}

.dofus-cursor-size_ns {
    cursor: url("/Assets/UI/Themes/darkStone/cursor/aero_ns.png") 8 20;
}

.dofus-cursor-size_ew {
    cursor: url("/Assets/UI/Themes/darkStone/cursor/aero_ew.png") 20 8;
}

.fight-ap-cursor {
    overflow: visible;
    font-size: 19px;
    height: 19px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    color: rgb(76, 160, 255);
    -unity-font-definition: url("/Assets/Resources/DefaultFont.asset");
    -unity-text-outline-width: 1;
    -unity-text-outline-color: black;
    text-shadow: 0 2px 0 black;
}

.fight-mp-cursor {
    overflow: visible;
    font-size: 19px;
    height: 19px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    color: rgb(0, 224, 0);
    -unity-font-definition: url("/Assets/Resources/DefaultFont.asset");
    -unity-text-outline-width: 1;
    -unity-text-outline-color: black;
    text-shadow: 0 2px 0 black;
}

