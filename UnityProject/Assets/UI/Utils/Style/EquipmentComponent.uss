#icon_arrow {
    -unity-background-image-tint-color: var( --highlight_primary80);
}

#btn_arrowLeft:hover #icon_arrow {
    -unity-background-image-tint-color: var( --highlight_primary100);
}

#btn_arrowLeft:active #icon_arrow {
    -unity-background-image-tint-color: var( --white_white100);
}

#btn_arrowRight:hover #icon_arrow {
    -unity-background-image-tint-color: var( --highlight_primary100);
}

#btn_arrowRight:active #icon_arrow {
    -unity-background-image-tint-color: var( --white_white100);
}

