.tutorialArrow {
    align-items: flex-end;
    justify-content: center;
}

.tutorialArrow__image {
    background-image: url("/Assets/UI/Themes/darkStone/texture/arrow.png");
    -unity-background-scale-mode: scale-to-fit;
    width: 64px;
    height: 64px;
    position: absolute;
}

.tutorialArrow__image-reverse {
    scale: -1 1;
}

