.elidable-multiline-label {
    flex-shrink: 0;
}

.elidable-multiline-label__inner-label {
    width: 100%;
    height: 100%;
    white-space: normal;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

