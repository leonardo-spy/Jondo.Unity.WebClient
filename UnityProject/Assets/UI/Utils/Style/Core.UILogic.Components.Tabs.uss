.dofus-tab-small {
    background-image: url("/Assets/UI/USSTextures/tab_small_normal.png");
}

.dofus-tab-small:hover {
    background-image: url("/Assets/UI/USSTextures/tab_small_over.png");
}

.dofus-tab-small:active {
    background-image: url("/Assets/UI/USSTextures/tab_small_pressed.png");
}

.dofus-tab-small--selected {
    background-image: url("/Assets/UI/USSTextures/tab_small_selected.png");
}

.dofus-tab-small--selected:hover {
    background-image: url("/Assets/UI/USSTextures/tab_small_selectedOver.png");
}

.dofus-tab-small--selected:active {
    background-image: url("/Assets/UI/USSTextures/tab_small_selectedPressed.png");
}

.dofus-tab {
    background-image: url("/Assets/UI/Themes/darkStone/common/bg_tab_disabled_normal.png");
}

.dofus-tab:hover {
    background-image: url("/Assets/UI/Themes/darkStone/common/bg_tab_disabled_over.png");
}

.dofus-tab:active {
    background-image: url("/Assets/UI/Themes/darkStone/common/bg_tab_disabled_pressed.png");
}

.dofus-tab--selected {
    background-image: url("/Assets/UI/Themes/darkStone/common/bg_tab_selected_normal.png");
}

.dofus-tab--selected:hover {
    background-image: url("/Assets/UI/USSTextures/bg_tab_selected_over.png");
}

.dofus-tab--selected:active {
    background-image: url("/Assets/UI/USSTextures/bg_tab_selected_pressed.png");
}

