.button_p {
    color: rgb(47, 47, 37);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    -unity-font: url("/Assets/Resources/DefaultFont.asset");
    font-size: 15px;
}

.button_small_p {
    color: rgb(47, 47, 37);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    -unity-font: url("/Assets/Resources/DefaultFont.asset");
    font-size: 13px;
}

.dofus-button {
    background-image: url("/Assets/UI/USSTextures/btn_green_normal.png");
    background-color: transparent;
    border-color: transparent;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    color: rgb(47, 47, 37);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    -unity-font: url("/Assets/Resources/DefaultFont.asset");
    font-size: 15px;
}

.dofus-button:hover {
    background-image: url("/Assets/UI/USSTextures/btn_green_over.png");
    background-color: transparent;
}

.dofus-button:focus {
    background-image: url("/Assets/UI/USSTextures/btn_green_over.png");
    background-color: transparent;
}

.dofus-button:focus:active {
    background-image: url("/Assets/UI/USSTextures/btn_green_pressed.png");
    background-color: transparent;
}

.dofus-button:active {
    background-image: url("/Assets/UI/USSTextures/btn_green_pressed.png");
    background-color: transparent;
}

.dofus-button:checked {
    background-image: url("/Assets/UI/USSTextures/btn_green_pressed.png");
    background-color: transparent;
}

.dofus-button:disabled {
    background-color: transparent;
}

.dofus-button__label:disabled {
    color: rgb(0, 0, 0);
}

.dofus-button__icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
    min-width: 32px;
}

.dofus-button-iconOnly__icon {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.dofus-button-grown__label {
    flex-grow: 1;
}

