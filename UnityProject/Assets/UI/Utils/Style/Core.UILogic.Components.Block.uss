.block {
    flex-shrink: 0;
    flex-grow: 1;
}

.block__background {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0.5;
    background-image: url("/Assets/UI/USSTextures/block_background_second.png");
}

.block__scratch {
    position: absolute;
    background-image: url("/Assets/UI/USSTextures/block_border_scratch.png");
    -unity-slice-left: 75;
    -unity-slice-top: 66;
    -unity-slice-right: 75;
    -unity-slice-bottom: 66;
    opacity: 0.5;
    width: 100%;
    height: 100%;
}

.block__content {
    padding: 5px;
    flex-shrink: 1;
    flex-grow: 1;
}

.block__border {
    position: absolute;
    background-image: url("/Assets/UI/USSTextures/block_border_double_scratch.png");
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 12;
    opacity: 0.5;
    width: 100%;
    height: 100%;
}

.doubleBlock {
    flex-grow: 1;
    flex-shrink: 0;
}

.doubleBlock__background {
    background-image: url("/Assets/UI/USSTextures/block_background_second.png");
    position: absolute;
    width: 100%;
    height: 100%;
}

.doubleBlock__scratch {
    background-image: url("/Assets/UI/USSTextures/block_border_double_scratch.png");
    -unity-slice-left: 180;
    -unity-slice-top: 125;
    -unity-slice-right: 180;
    -unity-slice-bottom: 200;
    position: absolute;
    width: 100%;
    height: 100%;
}

.doubleBlock__content {
    flex-grow: 1;
    flex-shrink: 1;
}

.doubleBlock__border {
    background-image: url("/Assets/UI/USSTextures/block_border_double_scratch.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 20;
    -unity-slice-top: 20;
    -unity-slice-right: 20;
    -unity-slice-bottom: 20;
    display: flex;
    position: absolute;
    width: 100%;
    height: 100%;
}

