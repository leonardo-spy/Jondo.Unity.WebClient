.combobox__downArrow {
    background-image: url("/Assets/UI/InlineTextures/forgettableSpellList_5_contextMenuDownArrow.png");
    -unity-background-scale-mode: scale-to-fit;
    width: 20px;
    height: 20px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.combobox__upArrow {
    background-image: url("/Assets/UI/InlineTextures/commonSpellsList_1_contextMenuUpArrow.png");
    -unity-background-scale-mode: scale-to-fit;
    width: 20px;
    height: 20px;
    display: none;
}

.combobox__scrollview {
    background-color: rgba(0, 0, 0, 0);
    align-items: flex-start;
    justify-content: flex-start;
    padding-top: 0;
    padding-bottom: 0;
}

.combobox {
    background-image: url("/Assets/UI/USSTextures/bg_small_border_light_cropped.png");
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    min-height: 35px;
    flex-direction: row-reverse;
}

.combobox__button {
    background-color: rgba(41, 41, 41, 0);
    color: rgb(255, 255, 255);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 11;
    -unity-slice-bottom: 10;
    margin-top: 0px;
    margin-bottom: 0px;
    padding-top: 0px;
    padding-bottom: 0px;
    margin-left: 0px;
    margin-right: 0px;
    padding-left: 10px;
    padding-right: 10px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 100%;
    -unity-text-align: middle-left;
}

.combobox__button:disabled {
    background-color: rgba(41, 41, 41, 0);
}

.combobox__item {
    height: 30px;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    -unity-text-align: upper-left;
    align-content: flex-start;
    justify-content: center;
    color: rgb(255, 255, 255);
    margin-top: 0;
    margin-bottom: 0;
    margin-right: 0;
    margin-left: 0;
    padding-top: 4px;
    padding-bottom: 4px;
}

.combobox__item__label__multi {
    width: 100%;
    position: absolute;
    left: 45px;
    height: 30px;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
    color: rgb(255, 255, 255);
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
}

.combobox__item__label {
    width: 100%;
    height: 30px;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
    color: rgb(255, 255, 255);
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
}

.combobox__item:hover {
    background-color: rgba(59, 60, 59, 0.6);
}

.combobox__item__keyboardFocus {
    background-color: rgba(59, 60, 59, 0.6);
}

.combobox__item__checkmark {
    width: 30px;
    height: 30px;
    background-image: none;
}

.combobox__item__root {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.8);
}

.combobox__item__selected {
    background-color: rgb(63, 63, 63);
}

.combobox__item__selected .combobox__item__checkmark {
    background-image: url("/Assets/UI/USSTextures/check1.png");
}

.combobox__button__content {
    flex-direction: row;
    align-items: center;
}

.combobox__button__content-element {
    flex-direction: row;
    align-items: center;
    position: absolute;
}

.combobox__button__content__mask {
    position: absolute;
    left: 12px;
    flex-direction: row;
    overflow: hidden;
}

.combobox__arrowContainer {
    width: 100%;
    flex-direction: row-reverse;
    align-items: center;
    position: absolute;
    height: 100%;
    min-height: 25px;
}

.combobox .combobox__inputField {
    width: 100%;
    flex-direction: row-reverse;
    align-items: center;
    position: absolute;
    height: 100%;
    min-height: 40px;
    border-radius: 0;
    background-image: none;
    padding-right: 20px;
}

.combobox__item__root:hover {
    background-color: rgb(59, 60, 59);
}

.combobox__button:hover {
    background-color: rgba(67, 67, 67, 0);
}

.unity-base-dropdown__container-outer {
    margin-top: 0;
    padding-top: 4;
    background-color: rgba(0, 0, 0, 0.95);
}

