.default_green_button {
    position: relative;
    width: auto;
    height: auto;
    flex-shrink: 0;
    display: flex;
    align-items: auto;
    justify-content: center;
    background-image: url("/Assets/UI/USSTextures/btn_green_normal.png");
}

.default_green_button:hover {
    position: relative;
    width: auto;
    height: auto;
    flex-shrink: 0;
    display: flex;
    align-items: auto;
    justify-content: center;
    background-image: url("/Assets/UI/USSTextures/btn_green_over.png");
}

.default_green_button:active {
    position: relative;
    width: auto;
    height: auto;
    flex-shrink: 0;
    display: flex;
    align-items: auto;
    justify-content: center;
    background-image: url("/Assets/UI/USSTextures/btn_green_pressed.png");
}

.default_green_button:disabled {
    position: relative;
    width: auto;
    height: auto;
    flex-shrink: 0;
    display: flex;
    align-items: auto;
    justify-content: center;
    background-image: url("/Assets/UI/USSTextures/btn_green_disabled.png");
}

