#sv_toggles {
    border-bottom-width: 1px;
    border-bottom-color: var( --background_medium90);
}

#scrollChat #unity-content-container {
    flex-shrink: 0;
}

#scrollChat #unity-content-viewport {
    justify-content: flex-end;
}

#scrollChat #unity-content-and-vertical-scroll-container {
    flex-direction: row;
}

.unity-list-view .unity-scroll-view__content-container {
    padding-bottom: 10px;
}

