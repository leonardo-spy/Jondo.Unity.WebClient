.btn_plus:hover {
    background-image: url("/Assets/UI/USSTextures/btn_green_small_over.png");
}

.btn_plus {
    background-image: url("/Assets/UI/InlineTextures/fighterGridSlot_7_btn_green_small_normal.png");
}

.btn_plus:active {
    background-image: url("/Assets/UI/USSTextures/btn_green_small_pressed.png");
}

.btn_plus:disabled {
    background-image: url("/Assets/UI/USSTextures/btn_green_small_disabled.png");
}

.btn_plus:focus {
    background-image: url("/Assets/UI/USSTextures/btn_green_small_selected.png");
}

.btn_plus:focus:hover {
    background-image: url("/Assets/UI/USSTextures/btn_green_small_selectedover.png");
}

.btn_plus:focus:active {
    background-image: url("/Assets/UI/USSTextures/btn_green_small_selectedpressed.png");
}

