#gd_emblemBack .slot-item__background {
    background-image: url("/Assets/UI/Themes/darkStone/texture/slot/slot_dark_background_empty.png");
}

#gd_emblemFront .slot-item__background {
    background-image: url("/Assets/UI/Themes/darkStone/texture/slot/slot_grey_background_empty.png");
}

.renderstudio-grid-view__item--selected .slot-item__effect {
    background-image: url("/Assets/UI/Themes/darkStone/texture/slot/selected.png");
}

.renderstudio-grid-view__item--selected:hover .slot-item__effect {
    background-image: url("/Assets/UI/Themes/darkStone/texture/slot/selected.png");
}

