.propContainer {
    flex-direction: row;
    justify-content: space-between;
    flex-shrink: 0;
}

.leftText {
    -unity-text-align: middle-left;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.rightValue {
    -unity-text-align: middle-right;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.renderstudio-grid-view__item--alternative-background {
    background-color: rgba(0, 0, 0, 0.2);
}

