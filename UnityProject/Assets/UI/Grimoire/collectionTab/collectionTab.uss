.robotoboldcenter62 {
    font-size: 62px;
    color: rgb(199, 199, 197);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url("/Assets/Resources/DefaultFont.asset");
}

.whiteboldcenter {
    font-size: 16px;
    color: rgb(224, 224, 222);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url("/Assets/Resources/DefaultFont.asset");
}

.undiscovered #ctr_details {
