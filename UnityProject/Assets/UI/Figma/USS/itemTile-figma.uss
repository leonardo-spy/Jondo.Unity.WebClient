.itemTile {
    justify-content: center;
    align-items: center;
}

.itemTile.medium {
    width: 72px;
    height: 72px;
}

.itemTile.medium.inventory {
    --gap: 10px;
    flex-direction: row;
}

.itemTile.medium.button.icon {
    flex-direction: row;
    --gap: 10px;
}

.itemTile.medium.button.icon:disabled {
    overflow: hidden;
    border-radius: 8px;
}

.itemTile.medium.spell {
    --gap: 10px;
    flex-direction: row;
}

.itemTile.medium.spell.asset {
    border-radius: 12px;
}

.itemTile.small {
    width: 48px;
    height: 48px;
}

.itemTile.small.inventory {
    --gap: 10px;
    flex-direction: row;
}

.itemTile.small.inventory.asset.selectedTrue.acquiredTrue.green {
    overflow: hidden;
    border-radius: 2px;
}

.itemTile.small.button.icon {
    flex-direction: row;
    --gap: 10px;
}

.itemTile.small.button.icon:disabled {
    overflow: hidden;
    border-radius: 8px;
}

.itemTile.small.spell {
    --gap: 10px;
    flex-direction: row;
}

.itemTile.small.spell.asset.draggedTrue {
    overflow: hidden;
    border-radius: 8px;
}

.itemTile.xSmall.inventory {
    width: 26px;
    height: 26px;
    --gap: 10px;
    flex-direction: row;
}

.itemTile.xSmall.button {
    width: 32px;
    height: 32px;
}

.itemTile.xSmall.button.icon {
    flex-direction: row;
    --gap: 10px;
}

.itemTile.xSmall.button.icon:disabled {
    overflow: hidden;
    border-radius: 4px;
}

.itemTile.xSmall.spell {
    width: 26px;
    height: 26px;
    --gap: 10px;
    flex-direction: row;
}

.itemTile #itemTile_container {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.itemTile.medium.navigation #itemTile_container {
    border-radius: 8px;
    padding: 2px 2px 2px 2px;
}

.itemTile.medium.navigation.asset.acquiredTrue #itemTile_container {
    background-color: var( --buttons_buttonSecondaryHover);
}

.itemTile.medium.navigation.asset.acquiredTrue.hover:enabled #itemTile_container {
    background-color: var( --buttons_buttonSecondaryPressed);
}

.itemTile.medium.navigation.asset.selectedTrue.acquiredTrue #itemTile_container {
    background-color: var( --slots_selected);
}

.itemTile.medium.navigation.asset.selectedTrue.acquiredTrue.hover:enabled #itemTile_container {
    background-color: var( --slots_selectedHover);
}

.itemTile.medium.navigation.asset.acquiredFalse #itemTile_container {
    background-color: var( --black_black35);
}

.itemTile.medium.inventory #itemTile_container {
    border-radius: 2px;
    padding: 2px 2px 2px 2px;
}

.itemTile.medium.inventory.asset.acquiredTrue #itemTile_container {
    background-color: var( --buttons_buttonSecondary);
}

.itemTile.medium.inventory.asset.acquiredTrue.gold #itemTile_container {
    border-width: 2px;
}

.itemTile.medium.inventory.asset.acquiredTrue.gold.hover:enabled #itemTile_container {
    background-color: var( --buttons_buttonSecondaryHover);
}

.itemTile.medium.inventory.asset.acquiredTrue.gold:disabled #itemTile_container {
    background-color: var( --black_black15);
}

.itemTile.medium.inventory.asset.acquiredTrue.silver #itemTile_container {
    border-width: 2px;
}

.itemTile.medium.inventory.asset.acquiredTrue.silver.hover:enabled #itemTile_container {
    background-color: var( --buttons_buttonSecondaryHover);
}

.itemTile.medium.inventory.asset.acquiredTrue.silver:disabled #itemTile_container {
    background-color: var( --black_black15);
}

.itemTile.medium.inventory.asset.acquiredTrue.withBackgroundFalse #itemTile_container {
    background-color: rgba(255, 255, 255, 0);
}

.itemTile.medium.inventory.asset.acquiredTrue.draggedTrue #itemTile_container {
    background-color: var( --highlight_secondary80);
}

.itemTile.medium.inventory.asset.acquiredTrue.multiple #itemTile_container {
    background-color: var( --highlight_secondary100);
}

.itemTile.medium.inventory.asset.acquiredTrue.hover:enabled #itemTile_container {
    background-color: var( --buttons_buttonSecondaryHover);
}

.itemTile.medium.inventory.asset.ghostTrue #itemTile_container {
    opacity: 0.5;
}

.itemTile.medium.inventory.asset.ghostTrue.acquiredTrue #itemTile_container {
    background-color: var( --buttons_buttonSecondary);
}

.itemTile.medium.inventory.asset.ghostTrue.acquiredTrue.withBackgroundFalse #itemTile_container {
    background-color: rgba(255, 255, 255, 0);
}

.itemTile.medium.inventory.asset.selectedTrue #itemTile_container {
    border-color: var( --highlight_primary80);
    border-width: 2px;
}

.itemTile.medium.inventory.asset.selectedTrue.acquiredTrue #itemTile_container {
    background-color: var( --buttons_buttonSecondary);
}

.itemTile.medium.inventory.asset.selectedTrue.acquiredTrue.hover:enabled #itemTile_container {
    background-color: var( --buttons_buttonSecondaryHover);
}

.itemTile.medium.inventory.asset.favoriteTrue.acquiredTrue #itemTile_container {
    background-color: var( --white_white25);
}

.itemTile.medium.inventory.asset.favoriteTrue.acquiredTrue.draggedTrue #itemTile_container {
    background-color: var( --highlight_secondary80);
}

.itemTile.medium.inventory.asset.favoriteTrue.acquiredTrue.hover:enabled #itemTile_container {
    background-color: var( --white_white50);
}

.itemTile.medium.inventory.asset.favoriteTrue.ghostTrue #itemTile_container {
    opacity: 0.5;
    background-color: var( --white_white25);
}

.itemTile.medium.inventory.asset.favoriteTrue.selectedTrue #itemTile_container {
    border-color: var( --highlight_primary80);
    border-width: 2px;
}

.itemTile.medium.inventory.asset.favoriteTrue.selectedTrue.acquiredTrue #itemTile_container {
    background-color: var( --white_white25);
}

.itemTile.medium.inventory.asset.favoriteTrue.selectedTrue.acquiredTrue.hover:enabled #itemTile_container {
    background-color: var( --white_white50);
}

.itemTile.medium.inventory.asset:disabled #itemTile_container {
    background-color: var( --black_black15);
}

.itemTile.medium.inventory.asset.acquiredFalse #itemTile_container {
    background-color: var( --buttons_buttonNegative);
}

.itemTile.medium.inventory.asset.acquiredFalse.active:enabled #itemTile_container {
    background-color: var( --buttons_buttonNegativePressed);
}

.itemTile.medium.inventory.asset.acquiredFalse.hover:enabled #itemTile_container {
    background-color: var( --buttons_buttonNegativeHover);
}

.itemTile.medium.inventory.asset.partial #itemTile_container {
    background-color: var( --buttons_buttonWarning);
}

.itemTile.medium.inventory.asset.partial.active:enabled #itemTile_container {
    background-color: var( --buttons_buttonWarningPressed);
}

.itemTile.medium.inventory.asset.partial.hover:enabled #itemTile_container {
    background-color: var( --buttons_buttonWarningHover);
}

.itemTile.medium.inventory:disabled #itemTile_container {
    background-color: var( --black_black15);
}

.itemTile.medium.cosmetic #itemTile_container {
    border-radius: 8px;
    padding: 2px 2px 2px 2px;
}

.itemTile.medium.cosmetic.asset.acquiredTrue #itemTile_container {
    background-color: var( --buttons_buttonSecondary);
}

.itemTile.medium.cosmetic.asset.acquiredTrue.hover:enabled #itemTile_container {
    background-color: var( --buttons_buttonSecondaryHover);
}

.itemTile.medium.cosmetic.asset.selectedTrue.acquiredTrue #itemTile_container {
    background-color: var( --slots_selected);
}

.itemTile.medium.cosmetic.asset.selectedTrue.acquiredTrue.hover:enabled #itemTile_container {
    background-color: var( --slots_selectedHover);
}

.itemTile.medium.cosmetic.asset.selectedTrue.acquiredFalse #itemTile_container {
    background-color: var( --white_white10);
    border-color: var( --white_white25);
    border-width: 2px;
}

.itemTile.medium.cosmetic.asset.selectedTrue.acquiredFalse.hover:enabled #itemTile_container {
    background-color: var( --white_white15);
    border-color: var( --white_white50);
}

.itemTile.medium.cosmetic.asset.acquiredFalse #itemTile_container {
    background-color: var( --black_black35);
}

.itemTile.medium.cosmetic.asset.acquiredFalse.hover:enabled #itemTile_container {
    background-color: var( --black_black50);
}

.itemTile.medium.cosmetic.colorWheel.acquiredTrue #itemTile_container {
    background-color: var( --buttons_buttonSecondary);
}

.itemTile.medium.cosmetic.colorWheel.acquiredTrue.hover:enabled #itemTile_container {
    background-color: var( --buttons_buttonSecondaryHover);
}

.itemTile.medium.cosmetic.colorWheel.selectedTrue.acquiredTrue #itemTile_container {
    background-color: var( --slots_selected);
}

.itemTile.medium.cosmetic.colorWheel.selectedTrue.acquiredTrue.hover:enabled #itemTile_container {
    background-color: var( --slots_selectedHover);
}

.itemTile.medium.cosmetic.icon.acquiredFalse #itemTile_container {
    background-color: var( --black_black35);
}

.itemTile.medium.cosmetic.icon.acquiredFalse.hover:enabled #itemTile_container {
    background-color: var( --black_black50);
}

.itemTile.medium.button #itemTile_container {
    border-radius: 8px;
    flex-direction: row;
}

.itemTile.medium.button.icon #itemTile_container {
    background-color: var( --buttons_buttonSecondaryHover);
    --shadow: var( --secondaryButton_innerShadowsEnabledHover);
}

.itemTile.medium.button.icon:disabled #itemTile_container {
    background-color: var( --white_white10);
}

.itemTile.medium.button.icon.active:enabled #itemTile_container {
    background-color: var( --white_white50);
    --shadow: "inset 0px 1px rgba(255,255,255,0.4) | inset 0px -1px rgba(255,255,255,0.4)";
}

.itemTile.medium.button.icon.hover:enabled #itemTile_container {
    background-color: var( --buttons_buttonSecondaryPressed);
}

.itemTile.medium.spell #itemTile_container {
    border-radius: 12px;
}

.itemTile.small.inventory #itemTile_container {
    border-radius: 2px;
}

.itemTile.small.inventory.asset.acquiredTrue #itemTile_container {
    background-color: var( --white_white5);
}

.itemTile.small.inventory.asset.acquiredTrue.withBackgroundFalse #itemTile_container {
    background-color: rgba(255, 255, 255, 0);
}

.itemTile.small.inventory.asset.acquiredTrue.blue #itemTile_container {
    background-color: var( --preset_bluePreset50);
}

.itemTile.small.inventory.asset.acquiredTrue.blue.hover:enabled #itemTile_container {
    background-color: var( --preset_bluePreset65);
}

.itemTile.small.inventory.asset.acquiredTrue.blue.active:enabled #itemTile_container {
    background-color: var( --preset_bluePreset85);
}

.itemTile.small.inventory.asset.acquiredTrue.draggedTrue #itemTile_container {
    background-color: var( --highlight_secondary100);
}

.itemTile.small.inventory.asset.acquiredTrue.draggedTrue.blue #itemTile_container {
    background-color: var( --preset_bluePreset85);
}

.itemTile.small.inventory.asset.acquiredTrue.draggedTrue.green #itemTile_container {
    background-color: var( --outfit_greenOutfit85);
}

.itemTile.small.inventory.asset.acquiredTrue.draggedTrue:disabled #itemTile_container {
    background-color: var( --highlight_secondary50);
}

.itemTile.small.inventory.asset.acquiredTrue.green #itemTile_container {
    background-color: var( --outfit_greenOutfit50);
}

.itemTile.small.inventory.asset.acquiredTrue.green.hover:enabled #itemTile_container {
    background-color: var( --outfit_greenOutfit65);
}

.itemTile.small.inventory.asset.acquiredTrue.green.active:enabled #itemTile_container {
    background-color: var( --outfit_greenOutfit85);
}

.itemTile.small.inventory.asset.acquiredTrue.hover:enabled #itemTile_container {
    background-color: var( --white_white15);
}

.itemTile.small.inventory.asset.acquiredTrue.active:enabled #itemTile_container {
    background-color: var( --white_white35);
}

.itemTile.small.inventory.asset.ghostTrue #itemTile_container {
    opacity: 0.5;
}

.itemTile.small.inventory.asset.ghostTrue.acquiredTrue #itemTile_container {
    background-color: var( --white_white5);
}

.itemTile.small.inventory.asset.ghostTrue.partial #itemTile_container {
    padding: 2px 2px 2px 2px;
    background-color: var( --buttons_buttonWarning);
}

.itemTile.small.inventory.asset.ghostTrue.acquiredFalse #itemTile_container {
    padding: 2px 2px 2px 2px;
    background-color: var( --buttons_buttonNegative);
}

.itemTile.small.inventory.asset.selectedTrue.acquiredTrue #itemTile_container {
    background-color: var( --white_white5);
    border-color: var( --white_white100);
    border-width: 1px;
}

.itemTile.small.inventory.asset.selectedTrue.acquiredTrue.green #itemTile_container {
    background-color: var( --slots_selected);
    border-color: rgb(0, 0, 0);
    border-width: 0;
}

.itemTile.small.inventory.asset.selectedTrue.acquiredTrue.green.hover:enabled #itemTile_container {
    background-color: var( --slots_selectedHover);
}

.itemTile.small.inventory.asset:disabled #itemTile_container {
    padding: 2px 2px 2px 2px;
    background-color: var( --black_black15);
}

.itemTile.small.inventory.asset.partial #itemTile_container {
    padding: 2px 2px 2px 2px;
    background-color: var( --buttons_buttonWarning);
}

.itemTile.small.inventory.asset.acquiredFalse #itemTile_container {
    padding: 2px 2px 2px 2px;
    background-color: var( --buttons_buttonNegative);
}

.itemTile.small.button #itemTile_container {
    border-radius: 8px;
    flex-direction: row;
}

.itemTile.small.button.icon #itemTile_container {
    background-color: var( --buttons_buttonSecondaryHover);
    --shadow: var( --secondaryButton_innerShadowsEnabledHover);
}

.itemTile.small.button.icon:disabled #itemTile_container {
    background-color: var( --white_white10);
}

.itemTile.small.button.icon.active:enabled #itemTile_container {
    background-color: var( --white_white50);
    --shadow: "inset 0px 1px rgba(255,255,255,0.4) | inset 0px -1px rgba(255,255,255,0.4)";
}

.itemTile.small.button.icon.hover:enabled #itemTile_container {
    background-color: var( --buttons_buttonSecondaryPressed);
}

.itemTile.small.spell #itemTile_container {
    border-radius: 8px;
}

.itemTile.xSmall.inventory #itemTile_container {
    border-radius: 2px;
}

.itemTile.xSmall.inventory.asset.acquiredTrue:disabled #itemTile_container {
    background-color: var( --white_white5);
}

.itemTile.xSmall.inventory.asset.acquiredTrue.hover:enabled #itemTile_container {
    background-color: var( --white_white15);
}

.itemTile.xSmall.inventory.asset.acquiredTrue.active:enabled #itemTile_container {
    background-color: var( --white_white35);
}

.itemTile.xSmall.button #itemTile_container {
    border-radius: 4px;
    flex-direction: row;
}

.itemTile.xSmall.button.icon #itemTile_container {
    background-color: var( --buttons_buttonSecondaryHover);
    --shadow: var( --secondaryButton_innerShadowsEnabledHover);
}

.itemTile.xSmall.button.icon:disabled #itemTile_container {
    background-color: var( --white_white10);
}

.itemTile.xSmall.button.icon.active:enabled #itemTile_container {
    background-color: var( --white_white50);
    --shadow: "inset 0px 1px rgba(255,255,255,0.4) | inset 0px -1px rgba(255,255,255,0.4)";
}

.itemTile.xSmall.button.icon.hover:enabled #itemTile_container {
    background-color: var( --buttons_buttonSecondaryPressed);
}

.itemTile.xSmall.spell #itemTile_container {
    border-radius: 4px;
}

.itemTile #itemTile_indicatorCircle {
    position: absolute;
    width: 8px;
    min-width: 8px;
    height: 8px;
    min-height: 8px;
    overflow: hidden;
    border-radius: 20px;
    border-color: var( --black_black35);
    border-width: 1px;
    justify-content: center;
    align-items: center;
    --shadow: var( --dropShadows_light);
}

.itemTile.medium.navigation.asset.acquiredTrue #itemTile_indicatorCircle {
    left: 6px;
    top: 6px;
    background-color: var( --qualitative_green100);
}

.itemTile.medium.navigation.asset.selectedTrue #itemTile_indicatorCircle {
    left: 6px;
    top: 6px;
    background-color: var( --qualitative_green100);
}

.itemTile.medium.navigation.asset.acquiredFalse #itemTile_indicatorCircle {
    left: 5px;
    top: 6px;
    background-color: var( --qualitative_red100);
}

.itemTile.medium.navigation.asset.acquiredFalse.hover:enabled #itemTile_indicatorCircle {
    left: 2px;
    top: 3px;
}

.itemTile.medium.cosmetic.asset.acquiredTrue #itemTile_indicatorCircle {
    left: 6px;
    top: 6px;
    background-color: var( --qualitative_green100);
}

.itemTile.medium.cosmetic.asset.selectedTrue #itemTile_indicatorCircle {
    top: 6px;
}

.itemTile.medium.cosmetic.asset.selectedTrue.acquiredTrue #itemTile_indicatorCircle {
    left: 6px;
    background-color: var( --qualitative_green100);
}

.itemTile.medium.cosmetic.asset.selectedTrue.acquiredFalse #itemTile_indicatorCircle {
    left: 6px;
    background-color: var( --qualitative_red100);
}

.itemTile.medium.cosmetic.asset.selectedTrue.acquiredFalse.hover:enabled #itemTile_indicatorCircle {
    left: 5px;
}

.itemTile.medium.cosmetic.asset.acquiredFalse #itemTile_indicatorCircle {
    left: 5px;
    top: 6px;
    background-color: var( --qualitative_red100);
}

.itemTile.medium.cosmetic.asset.acquiredFalse.hover:enabled #itemTile_indicatorCircle {
    left: 2px;
    top: 3px;
}

.itemTile.medium.cosmetic.colorWheel #itemTile_indicatorCircle {
    left: 6px;
    top: 6px;
    background-color: var( --qualitative_green100);
}

.itemTile.medium.cosmetic.icon #itemTile_indicatorCircle {
    background-color: var( --qualitative_red100);
}

.itemTile.medium.cosmetic.icon.acquiredFalse #itemTile_indicatorCircle {
    left: 5px;
    top: 6px;
}

.itemTile.medium.cosmetic.icon.acquiredFalse.hover:enabled #itemTile_indicatorCircle {
    left: 2px;
    top: 3px;
}

.itemTile #itemTile_warning {
    position: absolute;
    justify-content: center;
    align-items: center;
}

.itemTile.medium #itemTile_warning {
    width: 20px;
    min-width: 20px;
    height: 20px;
    min-height: 20px;
}

.itemTile.medium.navigation #itemTile_warning {
    right: 4px;
    bottom: 4px;
}

.itemTile.medium.inventory #itemTile_warning {
    right: 4px;
    bottom: 4px;
}

.itemTile.medium.cosmetic #itemTile_warning {
    right: 4px;
    bottom: 4px;
}

.itemTile.medium.spell #itemTile_warning {
    right: 2px;
    bottom: 2px;
}

.itemTile.small.inventory.asset:disabled #itemTile_warning {
    right: 4px;
    bottom: 4px;
    width: 20px;
    min-width: 20px;
    height: 20px;
    min-height: 20px;
}

.itemTile.small.inventory.asset.partial #itemTile_warning {
    right: 2px;
    bottom: 3px;
    width: 18px;
    min-width: 18px;
    height: 18px;
    min-height: 18px;
}

.itemTile.small.inventory.asset.ghostTrue #itemTile_warning {
    right: 2px;
    bottom: 3px;
    width: 18px;
    min-width: 18px;
    height: 18px;
    min-height: 18px;
}

.itemTile.small.inventory.asset.acquiredFalse #itemTile_warning {
    right: 2px;
    bottom: 3px;
    width: 18px;
    min-width: 18px;
    height: 18px;
    min-height: 18px;
}

.itemTile.small.spell #itemTile_warning {
    right: 2px;
    bottom: 2px;
    width: 20px;
    min-width: 20px;
    height: 20px;
    min-height: 20px;
}

.itemTile.xSmall #itemTile_warning {
    left: 7px;
    top: 7px;
    width: 12px;
    min-width: 12px;
    height: 12px;
    min-height: 12px;
}

.itemTile #itemTile_warning_Vector {
    width: 100%;
    height: 100%;
    --hasShadow: true;
}

.itemTile.medium.navigation #itemTile_warning_Vector {
    -unity-background-image-tint-color: var( --qualitative_red100);
}

.itemTile.medium.inventory.asset.acquiredTrue #itemTile_warning_Vector {
    -unity-background-image-tint-color: var( --qualitative_red100);
}

.itemTile.medium.inventory.asset.ghostTrue #itemTile_warning_Vector {
    -unity-background-image-tint-color: var( --qualitative_red100);
}

.itemTile.medium.inventory.asset.selectedTrue #itemTile_warning_Vector {
    -unity-background-image-tint-color: var( --qualitative_red100);
}

.itemTile.medium.inventory.asset.favoriteTrue #itemTile_warning_Vector {
    -unity-background-image-tint-color: var( --qualitative_red100);
}

.itemTile.medium.inventory.asset:disabled #itemTile_warning_Vector {
    -unity-background-image-tint-color: var( --qualitative_red100);
}

.itemTile.medium.inventory.asset.acquiredFalse #itemTile_warning_Vector {
    -unity-background-image-tint-color: var( --qualitative_red100);
}

.itemTile.medium.inventory.asset.partial #itemTile_warning_Vector {
    -unity-background-image-tint-color: var( --qualitative_yellow100);
}

.itemTile.medium.inventory:disabled #itemTile_warning_Vector {
    -unity-background-image-tint-color: var( --qualitative_red100);
}

.itemTile.medium.cosmetic #itemTile_warning_Vector {
    -unity-background-image-tint-color: var( --qualitative_red100);
}

.itemTile.medium.spell #itemTile_warning_Vector {
    -unity-background-image-tint-color: var( --qualitative_red100);
}

.itemTile.small.inventory.asset:disabled #itemTile_warning_Vector {
    -unity-background-image-tint-color: var( --qualitative_red100);
}

.itemTile.small.inventory.asset.partial #itemTile_warning_Vector {
    -unity-background-image-tint-color: var( --qualitative_yellow100);
}

.itemTile.small.inventory.asset.ghostTrue.partial #itemTile_warning_Vector {
    -unity-background-image-tint-color: var( --qualitative_yellow100);
}

.itemTile.small.inventory.asset.ghostTrue.acquiredFalse #itemTile_warning_Vector {
    -unity-background-image-tint-color: var( --qualitative_red100);
}

.itemTile.small.inventory.asset.acquiredFalse #itemTile_warning_Vector {
    -unity-background-image-tint-color: var( --qualitative_red100);
}

.itemTile.small.spell #itemTile_warning_Vector {
    -unity-background-image-tint-color: var( --qualitative_red100);
}

.itemTile.xSmall #itemTile_warning_Vector {
    -unity-background-image-tint-color: var( --qualitative_red100);
}

.itemTile #itemTile_asset {
    justify-content: center;
    align-items: center;
}

.itemTile.medium.navigation #itemTile_asset {
    width: 100%;
    height: 100%;
}

.itemTile.medium.navigation.asset.acquiredFalse #itemTile_asset {
    opacity: 0.5;
}

.itemTile.medium.inventory #itemTile_asset {
    width: 100%;
    height: 100%;
}

.itemTile.medium.inventory.asset.acquiredTrue.gold:disabled #itemTile_asset {
    opacity: 0.5;
}

.itemTile.medium.inventory.asset.acquiredTrue.silver:disabled #itemTile_asset {
    opacity: 0.5;
}

.itemTile.medium.inventory.asset.acquiredTrue.multiple #itemTile_asset {
    opacity: 0.75;
}

.itemTile.medium.inventory.asset:disabled #itemTile_asset {
    opacity: 0.5;
}

.itemTile.medium.cosmetic #itemTile_asset {
    width: 100%;
