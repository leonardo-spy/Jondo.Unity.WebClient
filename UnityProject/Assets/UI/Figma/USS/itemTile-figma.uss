.itemTile.xSmall #itemTile_twinkle {
    border-radius: 4px;
    padding: 10px 10px 10px 10px;
}

.itemTile.small #itemTile_twinkle {
    border-radius: 8px;
    padding: 10px 10px 10px 10px;
}

.itemTile__timer {
    background-color: rgba(101, 101, 101, 0.5);
    width: 100%;
    height: 100%;
}

.itemTile__ctr-timer {
    position: absolute;
    width: 100%;
    height: 100%;
}

