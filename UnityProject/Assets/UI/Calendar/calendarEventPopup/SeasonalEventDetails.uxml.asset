        m_NamespaceDefinitions: []
        m_Properties:
        - name: name
          value: lbl_description
        - name: text
          value: "[Repaire privil\xE9gi\xE9 des Douziens en mal de sensations,\_Vulkania\_offre
            \xE0 ses visiteurs un panel d\u2019activit\xE9s jamais vues ailleurs.
            Vous souhaitez vous dorer la pilule ? Passez votre chemin !\n\nC\u2019est
            au\_sud de l\u2019\xEEle d\u2019Otoma\xEF\_que se trouve\_l\u2019archipel\_devenu
            c\xE9l\xE8bre, notamment, gr\xE2ce \xE0 ses\_deux occupants : Grozilla
            et Grasmera. Ici, les\_plages de sable\_blanc c\xF4toient les\_crat\xE8res
            de lave. Un doux m\xE9lange qui fait de Vulkania un lieu unique.]"
        - name: is-single-line
          value: false
        m_RuleIndex: 7
        m_Classes:
        - italicShort_large
        - textColor_highlight_secondary100
