#ctr_card.large {
    width: 848px;
}

#ctr_card.large #tx_cardPictureNormal {
    display: none;
}

#ctr_card.large #btn_cardLock {
    display: none;
}

#ctr_card.large #btn_cardHide {
    display: none;
}

#ctr_card.normal {
    width: 416px;
}

#ctr_card.normal #tx_cardPictureLarge {
    display: none;
}

#ctr_card.normal #lbl_cardDate {
    display: none;
}

#ctr_card.locked {
    background-color: var( --buttons_buttonSecondary);
}

