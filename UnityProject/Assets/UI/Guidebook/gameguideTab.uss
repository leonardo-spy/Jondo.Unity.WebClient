.category-grid-item {
    background-color: rgba(204, 204, 204, 0);
}

.category-grid-item:hover {
    background-color: rgba(204, 204, 204, 0.1);
}

.category-grid-item:checked {
    background-color: rgba(255, 255, 255, 0.3);
}

.unity-scroller--vertical {
    padding-top: 5;
    padding-bottom: 5;
}

