#btn_seeLink .dofus-button__icon {
    width: 20px;
    height: 20px;
    margin-right: 5px;
    -unity-background-scale-mode: scale-to-fit;
    min-width: 0;
    min-height: 0;
}

#btn_getAllRewards .dofus-button__icon {
    width: 22px;
    height: 22px;
    margin-left: 5px;
    -unity-background-scale-mode: scale-to-fit;
    min-width: 0;
    min-height: 0;
}

.bgLevel-Omega {
    background-image: url("/Assets/UI/Themes/darkStone/texture/tx_bg_level_omega.png");
}

.bgLevel-default {
    background-image: url("/Assets/UI/Themes/darkStone/texture/tx_bg_level_omega.png");
}

.verticalSeparator {
    background-image: url("/Assets/UI/InlineTextures/watchEquipmentUi_0_window_separator_vertical.png");
    left: 56px;
    top: 0;
    position: absolute;
    width: 4px;
    height: 56px;
}

.verticalSeparatorHighlighted {
    background-image: url("/Assets/UI/USSTextures/window_green_vertical_line.png");
    left: 56px;
    position: absolute;
    top: 0;
    width: 6px;
    height: 56px;
}

.validated-given {
    background-image: url("/Assets/UI/USSTextures/check_green.png");
    -unity-background-scale-mode: scale-to-fit;
    width: 20px;
    height: 20px;
}

.validated-not-validated {
    background-image: url("/Assets/UI/USSTextures/lock_dark.png");
    -unity-background-scale-mode: scale-to-fit;
    width: 20px;
    height: 20px;
    margin-left: -1px;
    margin-top: -1px;
}

.verticalSeparatorBig {
    background-image: url("/Assets/UI/InlineTextures/watchEquipmentUi_0_window_separator_vertical.png");
    left: 56px;
    top: 0;
    position: absolute;
    width: 4px;
    height: 38px;
}

.verticalSeparatorBigHighlighted {
    background-image: url("/Assets/UI/USSTextures/window_green_vertical_line.png");
    left: 56px;
    position: absolute;
    top: 0;
    width: 6px;
    height: 38px;
}

#btn_getReward .dofus-button__icon {
    width: 20px;
    height: 20px;
    -unity-background-scale-mode: scale-to-fit;
}

.progressBar-noBorder .extend-progress-bar__background {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

