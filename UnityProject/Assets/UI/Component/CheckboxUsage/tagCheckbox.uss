.tagCheckbox {
    background-color: var( --buttons_buttonSecondary);
}

.tagCheckbox:hover {
    background-color: var( --buttons_buttonSecondaryHover);
}

.tagCheckbox.active {
    background-color: var( --buttons_buttonSecondaryHover);
}

.tagCheckbox:disabled {
    background-color: var( --buttons_buttonDisabled);
}

