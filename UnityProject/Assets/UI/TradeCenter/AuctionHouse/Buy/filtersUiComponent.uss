#content .unity-scroller--vertical {
    width: auto;
    position: absolute;
    height: 100%;
    align-self: flex-end;
    padding: 2px;
}

#content .unity-scroll-view__content-and-vertical-scroll-container {
    justify-content: flex-end;
}

#footerButton {
    border-top-width: 1px;
    border-top-color: var( --white_white15);
}

.sectionHeader {
    padding-right: 16px;
}

.sectionHeaderContent {
    padding-right: 24px;
}

