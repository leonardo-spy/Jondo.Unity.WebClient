:root {
    --highlight_primary100: rgb(201, 237, 110);
    --highlight_primary25: rgba(201, 237, 110, 0.25);
    --highlight_primary50: rgba(201, 237, 110, 0.5);
    --highlight_primary80: rgba(201, 237, 110, 0.8);
    --highlight_secondary100: rgb(193, 182, 164);
    --highlight_secondary15: rgba(193, 182, 164, 0.15);
    --highlight_secondary25: rgba(193, 182, 164, 0.25);
    --highlight_secondary35: rgba(193, 182, 164, 0.35);
    --highlight_secondary50: rgba(193, 182, 164, 0.5);
    --highlight_secondary65: rgba(193, 182, 164, 0.65);
    --highlight_secondary80: rgba(193, 182, 164, 0.8);
    --buttons_buttonPrimary: rgba(143, 193, 36, 0.8);
    --buttons_buttonPrimaryHover: rgba(164, 214, 57, 0.8);
    --buttons_buttonPrimaryPressed: rgba(230, 255, 123, 0.8);
    --buttons_buttonSecondary: rgba(60, 64, 52, 0.8);
    --buttons_buttonSecondaryHover: rgba(86, 90, 78, 0.8);
    --buttons_buttonSecondaryPressed: rgba(167, 171, 159, 0.8);
    --background_dark100: rgb(36, 34, 30);
    --background_dark80: rgba(36, 34, 30, 0.8);
    --background_dark95: rgba(36, 34, 30, 0.95);
    --background_medium100: rgb(62, 60, 56);
    --background_medium90: rgba(62, 60, 56, 0.9);
    --header_background: rgba(255, 66, 30, 0.5);
    --header_gradient: rgba(249, 157, 113, 0.8);
    --background_highlight: rgb(121, 160, 64);
    --header_ornament: url("/Assets/UI/Themes/Figma/window/ornaments/ornamentWabbit.png");
}

