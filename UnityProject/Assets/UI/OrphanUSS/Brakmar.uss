:root {
    --highlight_primary100: rgb(255, 209, 148);
    --highlight_primary25: rgba(255, 209, 148, 0.25);
    --highlight_primary50: rgba(255, 209, 148, 0.5);
    --highlight_primary80: rgba(255, 209, 148, 0.8);
    --highlight_secondary100: rgb(178, 170, 171);
    --highlight_secondary15: rgba(178, 170, 171, 0.15);
    --highlight_secondary25: rgba(178, 170, 171, 0.25);
    --highlight_secondary35: rgba(178, 170, 171, 0.35);
    --highlight_secondary50: rgba(178, 170, 171, 0.5);
    --highlight_secondary65: rgba(178, 170, 171, 0.65);
    --highlight_secondary80: rgba(178, 170, 171, 0.8);
    --buttons_buttonPrimary: rgba(198, 140, 72, 0.8);
    --buttons_buttonPrimaryHover: rgba(213, 158, 93, 0.8);
    --buttons_buttonPrimaryPressed: rgba(221, 187, 146, 0.8);
    --buttons_buttonSecondary: rgba(61, 59, 59, 0.8);
    --buttons_buttonSecondaryHover: rgba(91, 88, 88, 0.8);
    --buttons_buttonSecondaryPressed: rgba(170, 166, 166, 0.8);
    --background_dark100: rgb(31, 31, 31);
    --background_dark80: rgba(31, 31, 31, 0.8);
    --background_dark95: rgba(31, 31, 31, 0.95);
    --background_medium100: rgb(41, 41, 41);
    --background_medium90: rgba(41, 41, 41, 0.9);
    --header_background: rgba(246, 82, 109, 0.2);
    --header_gradient: rgba(246, 82, 109, 0.8);
    --background_highlight: rgb(204, 102, 82);
    --header_ornament: url("/Assets/UI/Themes/Figma/window/ornaments/ornamentBrakmar.png");
}

