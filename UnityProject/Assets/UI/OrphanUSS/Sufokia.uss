:root {
    --highlight_primary100: rgb(255, 241, 148);
    --highlight_primary25: rgba(255, 241, 148, 0.25);
    --highlight_primary50: rgba(255, 241, 148, 0.5);
    --highlight_primary80: rgba(255, 241, 148, 0.8);
    --highlight_secondary100: rgb(192, 210, 229);
    --highlight_secondary15: rgba(192, 210, 229, 0.15);
    --highlight_secondary25: rgba(192, 210, 229, 0.25);
    --highlight_secondary35: rgba(192, 210, 229, 0.35);
    --highlight_secondary50: rgba(192, 210, 229, 0.5);
    --highlight_secondary65: rgba(192, 210, 229, 0.65);
    --highlight_secondary80: rgba(192, 210, 229, 0.8);
    --buttons_buttonPrimary: rgba(205, 166, 60, 0.8);
    --buttons_buttonPrimaryHover: rgba(227, 199, 89, 0.8);
    --buttons_buttonPrimaryPressed: rgba(252, 233, 158, 0.8);
    --buttons_buttonSecondary: rgba(73, 82, 96, 0.8);
    --buttons_buttonSecondaryHover: rgba(106, 119, 139, 0.8);
    --buttons_buttonSecondaryPressed: rgba(130, 142, 160, 0.8);
    --background_dark100: rgb(41, 43, 51);
    --background_dark80: rgba(41, 43, 51, 0.8);
    --background_dark95: rgba(41, 43, 51, 0.95);
    --background_medium100: rgb(62, 64, 71);
    --background_medium90: rgba(62, 64, 71, 0.9);
    --header_background: rgba(94, 188, 185, 0.2);
    --header_gradient: rgba(94, 188, 185, 0.8);
    --background_highlight: rgb(82, 174, 204);
    --header_ornament: url("/Assets/UI/Themes/Figma/window/ornaments/ornamentSufokia.png");
}

