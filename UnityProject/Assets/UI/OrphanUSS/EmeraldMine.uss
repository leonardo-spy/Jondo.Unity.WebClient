:root {
    --highlight_primary100: rgb(150, 248, 214);
    --highlight_primary25: rgba(150, 248, 214, 0.25);
    --highlight_primary50: rgba(150, 248, 214, 0.5);
    --highlight_primary80: rgba(150, 248, 214, 0.8);
    --highlight_secondary100: rgb(180, 214, 217);
    --highlight_secondary15: rgba(180, 214, 217, 0.15);
    --highlight_secondary25: rgba(180, 214, 217, 0.25);
    --highlight_secondary35: rgba(180, 214, 217, 0.35);
    --highlight_secondary50: rgba(180, 214, 217, 0.5);
    --highlight_secondary65: rgba(180, 214, 217, 0.65);
    --highlight_secondary80: rgba(180, 214, 217, 0.8);
    --buttons_buttonPrimary: rgba(44, 176, 141, 0.8);
    --buttons_buttonPrimaryHover: rgba(108, 218, 189, 0.8);
    --buttons_buttonPrimaryPressed: rgba(214, 245, 237, 0.8);
    --buttons_buttonSecondary: rgba(43, 54, 52, 0.8);
    --buttons_buttonSecondaryHover: rgba(74, 94, 90, 0.8);
    --buttons_buttonSecondaryPressed: rgba(155, 176, 172, 0.8);
    --background_dark100: rgb(31, 38, 37);
    --background_dark80: rgba(31, 38, 37, 0.8);
    --background_dark95: rgba(31, 38, 37, 0.95);
    --background_medium100: rgb(41, 47, 59);
    --background_medium90: rgba(41, 47, 59, 0.9);
    --header_background: rgba(137, 210, 217, 0.2);
    --header_gradient: rgba(137, 210, 217, 0.8);
    --background_highlight: rgb(115, 191, 166);
    --header_ornament: url("/Assets/UI/Themes/Figma/window/ornaments/ornamentEmeraldMine.png");
}

