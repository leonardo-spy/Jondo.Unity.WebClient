:root {
    --highlight_primary100: rgb(222, 237, 110);
    --highlight_primary25: rgba(222, 237, 110, 0.25);
    --highlight_primary50: rgba(222, 237, 110, 0.5);
    --highlight_primary80: rgba(222, 237, 110, 0.8);
    --highlight_secondary100: rgb(209, 184, 229);
    --highlight_secondary15: rgba(209, 184, 229, 0.15);
    --highlight_secondary25: rgba(209, 184, 229, 0.25);
    --highlight_secondary35: rgba(209, 184, 229, 0.35);
    --highlight_secondary50: rgba(209, 184, 229, 0.5);
    --highlight_secondary65: rgba(209, 184, 229, 0.65);
    --highlight_secondary80: rgba(209, 184, 229, 0.8);
    --buttons_buttonPrimary: rgba(172, 193, 36, 0.8);
    --buttons_buttonPrimaryHover: rgba(192, 215, 40, 0.8);
    --buttons_buttonPrimaryPressed: rgba(238, 245, 199, 0.8);
    --buttons_buttonSecondary: rgba(73, 68, 92, 0.8);
    --buttons_buttonSecondaryHover: rgba(88, 82, 111, 0.8);
    --buttons_buttonSecondaryPressed: rgba(169, 164, 188, 0.8);
    --background_dark100: rgb(37, 31, 46);
    --background_dark80: rgba(37, 31, 46, 0.8);
    --background_dark95: rgba(37, 31, 46, 0.95);
    --background_medium100: rgb(59, 53, 67);
    --background_medium90: rgba(59, 53, 67, 0.9);
    --header_background: rgba(209, 184, 229, 0.2);
    --header_gradient: rgba(209, 184, 229, 0.8);
    --background_highlight: rgb(166, 115, 191);
    --header_ornament: url("/Assets/UI/Themes/Figma/window/ornaments/ornamentBelladone.png");
}

