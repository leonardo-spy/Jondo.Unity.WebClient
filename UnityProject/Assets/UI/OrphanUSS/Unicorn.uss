:root {
    --highlight_primary100: rgb(255, 173, 237);
    --highlight_primary25: rgba(255, 173, 237, 0.25);
    --highlight_primary50: rgba(255, 173, 237, 0.5);
    --highlight_primary80: rgba(255, 173, 237, 0.8);
    --highlight_secondary100: rgb(208, 179, 208);
    --highlight_secondary15: rgba(208, 179, 208, 0.15);
    --highlight_secondary25: rgba(208, 179, 208, 0.25);
    --highlight_secondary35: rgba(208, 179, 208, 0.35);
    --highlight_secondary50: rgba(208, 179, 208, 0.5);
    --highlight_secondary65: rgba(208, 179, 208, 0.65);
    --highlight_secondary80: rgba(208, 179, 208, 0.8);
    --buttons_buttonPrimary: rgba(209, 107, 203, 0.8);
    --buttons_buttonPrimaryHover: rgba(224, 154, 219, 0.8);
    --buttons_buttonPrimaryPressed: rgba(247, 228, 245, 0.8);
    --buttons_buttonSecondary: rgba(82, 70, 83, 0.8);
    --buttons_buttonSecondaryHover: rgba(101, 86, 102, 0.8);
    --buttons_buttonSecondaryPressed: rgba(177, 164, 178, 0.8);
    --background_dark100: rgb(38, 34, 34);
    --background_dark80: rgba(38, 34, 34, 0.8);
    --background_dark95: rgba(38, 34, 34, 0.95);
    --background_medium100: rgb(60, 56, 56);
    --background_medium90: rgba(60, 56, 56, 0.9);
    --header_background: rgba(224, 135, 227, 0.2);
    --header_gradient: rgba(224, 135, 227, 0.8);
    --background_highlight: rgb(191, 96, 143);
    --header_ornament: url("/Assets/UI/Themes/Figma/window/ornaments/ornamentUnicorn.png");
}

