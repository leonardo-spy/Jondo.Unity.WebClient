:root {
    --highlight_primary100: rgb(255, 241, 148);
    --highlight_primary25: rgba(255, 241, 148, 0.25);
    --highlight_primary50: rgba(255, 241, 148, 0.5);
    --highlight_primary80: rgba(255, 241, 148, 0.8);
    --highlight_secondary100: rgb(250, 232, 214);
    --highlight_secondary15: rgba(250, 232, 214, 0.15);
    --highlight_secondary25: rgba(250, 232, 214, 0.25);
    --highlight_secondary35: rgba(250, 232, 214, 0.35);
    --highlight_secondary50: rgba(250, 232, 214, 0.5);
    --highlight_secondary65: rgba(250, 232, 214, 0.65);
    --highlight_secondary80: rgba(250, 232, 214, 0.8);
    --buttons_buttonPrimary: rgba(143, 193, 36, 0.8);
    --buttons_buttonPrimaryHover: rgba(164, 214, 57, 0.8);
    --buttons_buttonPrimaryPressed: rgba(230, 255, 123, 0.8);
    --buttons_buttonSecondary: rgba(66, 59, 52, 0.8);
    --buttons_buttonSecondaryHover: rgba(97, 87, 76, 0.8);
    --buttons_buttonSecondaryPressed: rgba(174, 168, 163, 0.8);
    --background_dark100: rgb(33, 33, 33);
    --background_dark80: rgba(33, 33, 33, 0.8);
    --background_dark95: rgba(33, 33, 33, 0.95);
    --background_medium100: rgb(55, 55, 55);
    --background_medium90: rgba(55, 55, 55, 0.9);
    --header_background: rgba(84, 154, 16, 0.3);
    --header_gradient: rgba(186, 224, 128, 0.8);
    --background_highlight: rgb(165, 191, 86);
    --header_ornament: url("/Assets/UI/Themes/Figma/window/ornaments/ornamentPandala.png");
}

