.radio {
    width: 24px;
    height: 24px;
}

.radio.checkedFalse {
    --shadow: var( --dropShadows_medium);
}

.radio.checkedTrue {
    --shadow: var( --transversal_dropShadowMedium);
}

.radio #radio_background {
    position: absolute;
    left: 4.166667%;
    top: 4.166667%;
    width: 91.66666%;
    min-width: 0;
    height: 91.66666%;
    min-height: 0;
    overflow: hidden;
    border-radius: 100px;
    border-width: 2px;
}

.radio.checkedFalse #radio_background {
    background-color: var( --black_black50);
    border-color: var( --highlight_secondary80);
}

.radio.checkedFalse:hover:enabled #radio_background {
    background-color: var( --black_black100);
    border-color: var( --highlight_secondary100);
}

.radio.checkedFalse:active:enabled #radio_background {
    background-color: var( --black_black100);
    border-color: var( --white_white100);
}

.radio.checkedFalse:disabled #radio_background {
    background-color: var( --black_black25);
    border-color: var( --buttons_buttonDisabled);
}

.radio.checkedTrue #radio_background {
    background-color: var( --black_black50);
    border-color: var( --highlight_secondary80);
}

.radio.checkedTrue:hover:enabled #radio_background {
    background-color: var( --black_black100);
    border-color: var( --highlight_secondary100);
}

.radio.checkedTrue:active:enabled #radio_background {
    background-color: var( --black_black100);
    border-color: var( --white_white100);
}

.radio.checkedTrue:disabled #radio_background {
    background-color: var( --black_black25);
    border-color: var( --buttons_buttonDisabled);
}

.radio #radio_icon {
    position: absolute;
    left: 8.333333%;
    top: 8.333333%;
    width: 83.33334%;
    min-width: 0;
    height: 83.33334%;
    min-height: 0;
    justify-content: center;
    align-items: center;
}

