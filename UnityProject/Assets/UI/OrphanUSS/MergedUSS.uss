.itemTile #itemTile_outlineRarity {
    align-self: stretch;
    position: absolute;
}

.itemTile.silver #itemTile_outlineRarity {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.itemTile.gold #itemTile_outlineRarity {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.itemTile.medium.inventory.asset.acquiredTrue.gold #itemTile_container {
    border-width: 0;
}

.itemTile.medium.inventory.asset.acquiredTrue.silver #itemTile_container {
    border-width: 0;
}

.itemTile.inventory.medium.gold #itemTile_outlineRarity {
    background-image: url("/Assets/UI/Themes/Figma/Tile/borderTileGoldMedium.png");
}

.itemTile.inventory.medium.silver #itemTile_outlineRarity {
    background-image: url("/Assets/UI/Themes/Figma/Tile/borderTileSilverMedium.png");
}

.itemTile #itemTile_conditionalBG,
.itemTile.medium #itemTile_conditionalBG {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    min-width: 100%;
    height: 100%;
    min-height: 100%;
    overflow: hidden;
    border-radius: 0;
    border-width: 0;
    justify-content: center;
    align-items: center;
    opacity: 0.5;
}

.itemTile.medium.cosmetic.moderate #itemTile_warning_Vector {
    -unity-background-image-tint-color: var( --qualitative_yellow100);
}

.itemSlotMount {
    width: 142px;
    height: 180px;
    overflow: hidden;
    border-radius: 8px;
    border-width: 2px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.itemSlotMount.selectedFalse.filledFalse {
    --gap: 4px;
}

.itemSlotMount.selectedFalse.filledFalse:hover:enabled {
    border-color: var( --highlight_secondary35);
}

.itemSlotMount.selectedFalse.filledTrue:hover:enabled {
    border-color: var( --highlight_secondary35);
}

.itemSlotMount.selectedTrue.filledFalse {
    border-color: var( --highlight_secondary80);
}

.itemSlotMount.selectedTrue.filledFalse:hover:enabled {
    border-color: var( --white_white100);
}

.itemSlotMount.selectedTrue.filledTrue {
    border-color: var( --highlight_secondary80);
}

.itemSlotMount.selectedTrue.filledTrue:hover:enabled {
    border-color: var( --white_white100);
}

.itemSlotMount #itemSlotMount_outlineDark {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 6px;
    border-color: var( --black_black25);
    border-width: 2px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.itemSlotMount #itemSlotMount_container {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 4px;
    --gap: 4px;
    padding: 10px 10px 10px 10px;
    align-items: center;
}

.itemSlotMount.selectedFalse.filledFalse #itemSlotMount_container {
    background-color: var( --black_black35);
    justify-content: center;
    --shadow: "inset 0px 2px rgba(0,0,0,0.35)";
}

.itemSlotMount.selectedFalse.filledFalse:hover:enabled #itemSlotMount_container {
    background-color: var( --buttons_buttonSecondary);
}

.itemSlotMount.selectedFalse.filledTrue #itemSlotMount_container {
    background-color: var( --buttons_buttonSecondary);
    --shadow: "inset 0px 1px rgba(255,255,255,0.2)";
}

.itemSlotMount.selectedFalse.filledTrue:hover:enabled #itemSlotMount_container {
    background-color: var( --buttons_buttonSecondaryHover);
    justify-content: center;
}

.itemSlotMount.selectedTrue #itemSlotMount_container {
    justify-content: center;
}

.itemSlotMount.selectedTrue.filledFalse #itemSlotMount_container {
    background-color: var( --buttons_buttonSecondary);
    --shadow: "inset 0px 2px rgba(0,0,0,0.35)";
}

.itemSlotMount.selectedTrue.filledFalse:hover:enabled #itemSlotMount_container {
    background-color: var( --buttons_buttonSecondaryHover);
}

.itemSlotMount.selectedTrue.filledTrue #itemSlotMount_container {
    background-color: var( --buttons_buttonSecondary);
    --shadow: "inset 0px 1px rgba(255,255,255,0.2)";
}

.itemSlotMount.selectedTrue.filledTrue:hover:enabled #itemSlotMount_container {
    background-color: var( --buttons_buttonSecondaryHover);
}

.itemSlotMount #itemSlotMount_light {
    position: absolute;
}

.itemSlotMount.selectedFalse.filledFalse #itemSlotMount_light {
    left: 40,  5px;
    top: 47px;
    width: 100%;
    height: 100%;
    -unity-background-image-tint-color: var( --highlight_secondary35);
    min-width: 124px;
    min-height: 147px;
    opacity: 0.25;
    background-image: none;
}

.itemSlotMount.selectedFalse.filledTrue #itemSlotMount_light {
    left: 40,  5px;
    top: 16px;
    width: 100%;
    height: 100%;
    -unity-background-image-tint-color: var( --highlight_secondary35);
    min-width: 124px;
    min-height: 147px;
    opacity: 0.25;
    background-image: none;
}

.itemSlotMount.selectedTrue.filledFalse #itemSlotMount_light {
    left: 40,  5px;
    top: 47px;
    width: 100%;
    height: 100%;
    -unity-background-image-tint-color: var( --highlight_secondary35);
    min-width: 124px;
    min-height: 147px;
    opacity: 0.25;
    background-image: none;
}

.itemSlotMount.selectedTrue.filledTrue #itemSlotMount_light {
    left: 40,  5px;
    top: 16px;
    width: 100%;
    height: 100%;
    -unity-background-image-tint-color: var( --highlight_secondary35);
    min-width: 124px;
    min-height: 147px;
    opacity: 0.25;
    background-image: none;
}

.itemSlotMount #itemSlotMount_icon {
    width: 64px;
    min-width: 64px;
    height: 64px;
    min-height: 64px;
    justify-content: center;
    align-items: center;
}

.itemSlotMount #itemSlotMount_icon_Vector {
    width: 100%;
    height: 100%;
    -unity-background-image-tint-color: var( --white_white25);
}

.itemSlotMount #itemSlotMount_label {
    width: 100%;
    -unity-text-align: middle-center;
    --text-style: "textShort_largeBold";
}

.itemSlotMount.selectedFalse #itemSlotMount_label {
    color: var( --white_white80);
}

.itemSlotMount.selectedFalse.filledFalse #itemSlotMount_label {
    height: 62px;
    min-height: 62px;
}

.itemSlotMount.selectedFalse.filledTrue #itemSlotMount_label {
    height: 100%;
}

.itemSlotMount.selectedTrue.filledFalse #itemSlotMount_label {
    height: 62px;
    min-height: 62px;
    color: var( --white_white80);
}

.itemSlotMount.selectedTrue.filledTrue #itemSlotMount_label {
    height: 100%;
    color: var( --white_white80);
}

.itemSlotMount.selectedTrue.filledTrue:hover:enabled #itemSlotMount_label {
    color: var( --white_white100);
}

.itemSlotMount #itemSlotMount_sexe {
    position: absolute;
    left: 109px;
    top: 5px;
    width: 20px;
    min-width: 20px;
    height: 20px;
    min-height: 20px;
    justify-content: center;
    align-items: center;
}

.itemSlotMount #itemSlotMount_sexe_Vector {
    width: 100%;
    height: 100%;
    -unity-background-image-tint-color: var( --qualitative_blue100);
    --hasShadow: true;
}

.itemSlotMount #itemSlotMount_asset {
    width: 80px;
    min-width: 80px;
    height: 80px;
    min-height: 80px;
    justify-content: center;
    align-items: center;
}

.itemSlotMount #itemSlotMount_asset_asset {
    width: 100%;
    height: 100%;
    background-image: none;
}

.itemSlotMount #itemSlotMount_tag {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.itemSlotMount #itemSlotMount_Ellipse_1692 {
    position: absolute;
    left: 42,  5px;
    top: 49px;
    width: 100%;
    height: 100%;
    -unity-background-image-tint-color: var( --highlight_secondary35);
}

.itemSlotMount > #itemSlotMount_outlineDark > #itemSlotMount_container > #itemSlotMount_light {
    background-image: url("/Assets/UI/InlineTextures/CharacterPresetUi_1_radialGradientCharact_white.png");
    -unity-background-image-tint-color: var( --highlight_secondary25);
    top: auto;
    left: auto;
    height: 130%;
    width: 130%;
    opacity: 0.6;
}

.itemSlotMount.filledTrue > #itemSlotMount_outlineDark > #itemSlotMount_container > #itemSlotMount_light {
    top: -30px;
}

RideSlot.refuseDrop.selectedTrue.itemSlotMount {
    border-color: var( --qualitative_red100);
}

RideSlot.acceptDrop.selectedTrue.itemSlotMount {
    border-color: var( --qualitative_lightGreen80);
}

.itemSlotMount > #itemSlotMount_outlineDark > #itemSlotMount_container > #itemSlotMount_sexe > .female#itemSlotMount_sexe_Vector {
    --icon: "femaleGender";
    -unity-background-image-tint-color: var( --qualitative_lightRed80);
}

#itemSlotMount_sexe_Vector {
    --icon: "maleGender";
    -unity-background-image-tint-color: var( --qualitative_blue100);
}

#itemSlotMount_label {
    overflow: hidden;
    flex-shrink: 1;
}

#itemSlotMount_tag {
    flex-shrink: 0;
}

.unity-list-view__empty-label {
    display: none;
}

.starRateIcon:disabled {
    opacity: 0.5;
}

