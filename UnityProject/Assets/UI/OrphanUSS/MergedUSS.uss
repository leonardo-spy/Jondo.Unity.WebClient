.dropArea {
    padding-top: 16px;
    padding-right: 20px;
    padding-bottom: 16px;
    padding-left: 20px;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    align-self: stretch;
}

.dropArea #dropArea_container {
    flex-grow: 1;
    border-radius: 4px;
    border-width: 2px;
    border-color: var( --highlight_secondary50);
    align-self: stretch;
    padding: 16px;
    --gap: 2px;
    align-items: center;
    justify-content: center;
}

.dropArea DofusLabel {
    --text-style: "italicShort_medium";
    color: var( --highlight_secondary80);
    white-space: normal;
    -unity-text-align: upper-center;
}

.dropArea #dropArea_icon {
    width: 32px;
    height: 32px;
    -unity-background-image-tint-color: var( --highlight_secondary80);
}

.dropArea.dragHover #dropArea_container {
    background-color: var( --highlight_secondary25);
    border-color: var( --highlight_secondary100);
}

.dropArea.dragHover #dropArea_icon {
    -unity-background-image-tint-color: var( --highlight_secondary100);
}

.dropArea:active DofusLabel {
