.resizablewindow #background {
    background-image: url("/Assets/UI/Themes/Figma/window/widget-gradient.png");
    transition-property: opacity;
    transition-duration: 500ms;
    transition-delay: 1ms;
}

.delayedOpacity #background {
    transition-delay: 1s;
}

.resizablewindow__background {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var( --background_medium90);
    border-radius: 4px;
    --shadow: "inset -1px -1px rgba(0,0,0,0.13) | inset 1px 1px rgba(255,255,255,0.1)";
}

.forcedOpacity > .resizablewindow__background {
