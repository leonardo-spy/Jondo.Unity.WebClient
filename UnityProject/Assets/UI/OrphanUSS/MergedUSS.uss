.currencyField {
    width: 182px;
    height: 34px;
    overflow: hidden;
    border-radius: 5px;
    --gap: 8px;
    padding: 4px 4px 4px 4px;
    background-color: var( --black_black35);
    border-color: var( --highlight_secondary50);
    border-width: 1px;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.currencyField #currencyField_backGradient {
    position: absolute;
    left: 2;
    width: 180px;
    min-width: 180px;
    height: 32px;
    min-height: 32px;
    overflow: hidden;
    border-radius: 4px;
    border-color: var( --black_black35);
    border-width: 1px;
}

.currencyField.nugget #currencyField_backGradient {
    top: 5;
}

.currencyField.default #currencyField_backGradient {
    top: 2;
}

.currencyField.ogrine #currencyField_backGradient {
    top: 2;
}

.currencyField #currencyField_text {
    width: 100px;
    min-width: 100px;
    -unity-text-align: upper-right;
    --text-style: "textShort_largeBold";
    -unity-text-outline-color: rgba(0, 0, 0, 0.35);
    -unity-text-outline-width: 1px;
    -unity-font-style: bold;
    --labelShadow: var( --dropShadows_light);
