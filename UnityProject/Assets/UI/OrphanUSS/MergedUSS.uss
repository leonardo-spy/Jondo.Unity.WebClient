.header {
    align-items: center;
}

.header.primary {
    width: 100%;
    height: 42px;
    border-radius: 12px 12px 0 0;
    background-color: var( --header_background);
    flex-direction: row;
    justify-content: space-between;
    --shadow: "inset 0px 1px rgba(255,255,255,0.2)";
    -unity-background-image-tint-color: var( --header_gradient);
    background-image: url("/Assets/UI/Themes/Figma/window/headerHighlight.png");
}

.header.primary > #header_ornament_left {
    border-top-left-radius: 12px;
    position: absolute;
    background-image: var( --header_ornament);
    -unity-background-image-tint-color: var( --highlight_secondary100);
    width: 280px;
    height: 40px;
}

.header.primary > #header_ornament_right {
    border-top-left-radius: 12px;
    position: absolute;
    right: 0;
    background-image: var( --header_ornament);
    -unity-background-image-tint-color: var( --highlight_secondary100);
    width: 280px;
    height: 40px;
    scale: -1 1;
}

.header.secondary {
    width: 100%;
    height: 38px;
    border-radius: 12px 12px 0 0;
    background-color: var( --highlight_secondary35);
    flex-direction: row;
    justify-content: space-between;
}

.header.widget {
    border-radius: 4px 4px 0 0;
}

.header.widget.horizontal {
    width: 100%;
    flex-direction: row;
}

.header.widget.horizontal.large {
    height: 24px;
    justify-content: space-between;
}

.header.widget.horizontal.large:hover:enabled {
    --gap: 4px;
    background-color: var( --white_white10);
    justify-content: center;
}

.header.widget.horizontal.small {
    height: 10px;
    justify-content: space-between;
}

.header.widget.horizontal.small:hover:enabled {
    --gap: 4px;
    background-color: var( --white_white10);
    justify-content: center;
}

.header.widget.vertical {
    height: 100%;
    justify-content: space-between;
}

.header.widget.vertical.large {
    width: 24px;
}

.header.widget.vertical.small {
    width: 10px;
}

.header.primary #header_left {
    width: 74px;
    min-width: 74px;
    height: 42px;
    min-height: 42px;
    --gap: 10px;
    padding: 10px 10px 10px 10px;
    justify-content: center;
}

.header.secondary #header_left {
    width: 74px;
    min-width: 74px;
    height: 38px;
    min-height: 38px;
    --gap: 10px;
    padding: 10px 10px 10px 10px;
    justify-content: center;
}

.header.widget #header_left {
    width: 20px;
    height: 20px;
    padding: 2px 2px 2px 2px;
    flex-direction: row;
}

.header.widget.horizontal.small #header_left {
    height: 100%;
    opacity: 0;
}

.header .button#header_buttonLeft {
    border-radius: 2px;
}

.header.primary .button#header_buttonLeft {
    width: 20px;
    min-width: 20px;
    height: 20px;
    min-height: 20px;
}

.header.secondary .button#header_buttonLeft {
    width: 24px;
    min-width: 24px;
    height: 24px;
    min-height: 24px;
}

.header.widget .button#header_buttonLeft {
    width: 20px;
    min-width: 20px;
    height: 20px;
    min-height: 20px;
}

.header #header_content {
    --gap: 4px;
    justify-content: center;
    align-items: center;
}

.header.primary #header_content {
    width: 100%;
    padding: 8px 0 8px 0;
}

.header.secondary #header_content {
    width: 100%;
    padding: 8px 0 8px 0;
}

.header.widget #header_content {
    flex-direction: row;
}

.header.widget.horizontal #header_content {
    width: 100%;
}

.header.widget.horizontal.large #header_content {
    height: 24px;
    min-height: 24px;
}

.header.widget.horizontal.small #header_content {
    height: 100%;
    opacity: 0;
}

.header.widget.vertical #header_content {
    height: 100%;
}

.header.widget.vertical.large #header_content {
    width: 24px;
    min-width: 24px;
}

.header.widget.vertical.small #header_content {
    width: 100%;
    opacity: 0;
}

.header.widget.vertical.small:hover:enabled {
    background-color: var( --white_white10);
}

.header.widget.vertical.large:hover:enabled {
    background-color: var( --white_white10);
}

.header #header_title {
    width: 100%;
    --gap: 8px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.header.primary #header_title {
    height: 26px;
    min-height: 26px;
}

.header #header_icon {
    justify-content: center;
    align-items: center;
}

.header.primary #header_icon {
    width: 30px;
    min-width: 30px;
    height: 30px;
    min-height: 30px;
}

.header.widget #header_icon {
    width: 20px;
    min-width: 20px;
    height: 20px;
    min-height: 20px;
}

.header.widget.horizontal.small:hover:enabled #header_icon {
    opacity: 0;
}

.header.widget.vertical.small #header_icon {
