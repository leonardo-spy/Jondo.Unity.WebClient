    --primaryButton_innerShadowsPressed: "inset 0px -2px rgba(255,255,255,0.2) | inset 0px 2px rgba(255,255,255,0.1) | inset 0px 16px rgba(255,255,255,0.15)";
    --primaryButton_innerShadowsSmall: "inset 0px -2px rgba(0,0,0,0.3) | inset 0px 2px rgba(255,255,255,0.2) | inset 0px 14px rgba(255,255,255,0.1)";
    --primaryButton_largeInnerShadowsEnabledHover: "inset 0px -2px rgba(0,0,0,0.3) | inset 0px 2px rgba(255,255,255,0.2) | inset 0px 20px rgba(255,255,255,0.1)";
    --primaryButton_largeInnerShadowsPressed: "inset 0px -2px rgba(255,255,255,0.2) | inset 0px 2px rgba(255,255,255,0.1) | inset 0px 20px rgba(255,255,255,0.15)";
    --secondaryButton_dropShadow: "0px 1px rgba(0,0,0,0.25)";
    --secondaryButton_innerShadowsEnabledHover: "inset 0px 1px rgba(255,255,255,0.2) | 0px 1px rgba(0,0,0,0.25)";
