    width: 28px;
    min-width: 28px;
    height: 28px;
    min-height: 28px;
    overflow: hidden;
    border-radius: 2px;
}

.currencyField #currencyField_backGradient {
    position: absolute;
    left: 0;
    top: -10px;
    bottom: 0;
    right: 0;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    border-radius: 3px;
    border-color: var( --black_black35);
    border-width: 1px;
}

.currencyField.nugget #currencyField_backGradient {
    top: auto;
}

.currencyField.default #currencyField_backGradient {
    top: auto;
}

.currencyField.ogrine #currencyField_backGradient {
    top: auto;
}

.currencyField.guildKamas #currencyField_backGradient {
    top: auto;
}

