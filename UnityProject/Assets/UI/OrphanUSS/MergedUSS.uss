    --shadow: "inset 1px 1px rgba(255, 255, 255, 0.1) | inset -1px -1px rgba(0, 0, 0, 0.13)";
}

.unity-scroller .unity-base-slider--horizontal .unity-base-slider__dragger {
    background-color: var( --colorDragger);
    height: 8px;
    margin: 1px;
    border-radius: 2;
    --shadow: "inset 1px 1px rgba(255, 255, 255, 0.1) | inset -1px -1px rgba(0, 0, 0, 0.13)";
}

.unity-scroller:hover .unity-base-slider--vertical:hover .unity-base-slider__dragger:hover {
    background-color: var( --colorDraggerHover);
}

.unity-scroller:hover .unity-base-slider--horizontal .unity-base-slider__dragger {
    background-color: var( --colorDraggerHover);
}

.unity-scroller .unity-base-slider--vertical:active .unity-base-slider__dragge:active {
    background-color: var( --colorDraggerActive);
}

.unity-scroller:active .unity-base-slider--horizontal:active .unity-base-slider__dragger:active {
    background-color: var( --colorDraggerActive);
}

.unity-scroller .unity-base-slider--vertical {
    min-width: 10px;
}

.unity-scroller .unity-base-slider--horizontal {
    min-height: 10px;
}

.unity-scroller .unity-base-slider--vertical .unity-base-slider__tracker,
.unity-base-slider--horizontal .unity-base-slider__tracker {
    background-color: var( --clear);
    border-color: var( --clear);
}

.unity-scroller .unity-base-slider--vertical .unity-base-slider__tracker:hover,
.unity-base-slider--horizontal .unity-base-slider__tracker:hover {
    background-color: var( --clear);
    border-color: var( --clear);
}

.unity-scroller--vertical > .unity-scroller__slider {
    margin: 0;
}

.unity-scroller--horizontal > .unity-scroller__slider {
    margin: 0;
}

.unity-scroller--vertical > .unity-base-slider--vertical {
    width: 100%;
    background-color: var( --colorBackground);
}

.unity-scroller--horizontal > .unity-base-slider--horizontal {
    height: 100%;
    background-color: var( --colorBackground);
}

.unity-scroller--vertical > .unity-base-slider--vertical:hover {
    width: 100%;
    background-color: var( --colorBackgroundHover);
}

.unity-scroller--horizontal > .unity-base-slider--horizontal:hover {
    height: 100%;
    background-color: var( --colorBackgroundHover);
}

.contextMenu {
    position: absolute;
    min-width: 50px;
    max-width: 560px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.8);
    padding: 4px 0;
}

.contextMenu .listElement {
    width: 100%;
}

.contextMenu .contextualMenuHeader {
    width: 100%;
}

.contextMenu__separator {
    background-color: rgb(64, 64, 64);
    height: 1px;
}

.contextMenu__title {
    font-size: 16px;
    -unity-text-align: middle-left;
    color: rgb(179, 179, 177);
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding-left: 8px;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    height: 22px;
    background-color: rgba(81, 74, 60, 0.8);
}

.contextMenu__item {
    background-color: rgba(0, 0, 0, 0.9);
    flex-direction: row;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    align-items: center;
}

.contextMenu__item:disabled {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: rgba(0, 0, 0, 0.9);
    opacity: 1;
}

.contextMenu__item:hover:disabled {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: rgba(0, 0, 0, 0.9);
    opacity: 1;
}

.contextMenu__item-label {
    flex-grow: 1;
    -unity-text-align: lower-left;
    font-size: 16px;
    color: rgb(178, 179, 178);
    margin-left: 0;
    margin-right: 4px;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.contextMenu__item-label:disabled {
    -unity-text-align: lower-left;
    font-size: 16px;
    color: rgb(122, 122, 119);
}

.contextMenu__item-label:hover:disabled {
    -unity-text-align: lower-left;
    font-size: 16px;
    color: rgb(122, 122, 119);
}

.contextMenu__item-status-none {
