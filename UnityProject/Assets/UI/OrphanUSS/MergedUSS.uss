.toggle {
    overflow: hidden;
}

.toggle.primary.large {
    height: 32px;
}

.toggle.primary.large.normal.icon {
    width: 32px;
    border-radius: 2px;
}

.toggle.primary.large.normal.asset {
    width: 32px;
    border-radius: 2px;
}

.toggle.primary.large.normal.text {
    border-radius: 4px;
    justify-content: center;
    align-items: center;
}

.toggle.primary.large.normal.text.activeFalse:disabled {
    --gap: 10px;
}

.toggle.primary.large.normal.text.activeTrue:hover:enabled {
    --gap: 10px;
}

.toggle.primary.large.blue {
    width: 32px;
    border-radius: 2px;
}

.toggle.primary.large.blue.asset.activeTrue {
    border-color: var( --white_white100);
    border-width: 2px;
}

.toggle.primary.large.blue.asset.activeTrue:disabled {
    border-color: var( --white_white50);
}

.toggle.primary.large.green {
    width: 32px;
    border-radius: 2px;
}

.toggle.primary.large.green.asset.activeTrue {
    border-color: var( --white_white100);
    border-width: 2px;
}

.toggle.primary.large.green.asset.activeTrue:disabled {
    border-color: var( --white_white50);
}

.toggle.primary.medium {
    width: 24px;
    height: 24px;
    border-radius: 4px;
}

.toggle.primary.small {
