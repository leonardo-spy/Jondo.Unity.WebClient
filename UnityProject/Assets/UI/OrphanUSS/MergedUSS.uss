.switch #switch_background {
    left: 0;
    top: 0;
    position: absolute;
    overflow: hidden;
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0.5);
    width: 100%;
    height: 100%;
}

.switch #switch_circle {
    left: 4px;
    height: 20px;
    width: 20px;
    background-color: var( --unity-colors-slider_thumb-background);
    position: absolute;
    border-radius: 100px;
}

.switch.right #switch_background {
    transition-duration: 0.5s,  0.5s;
}

.switch.left #switch_background {
    transition-duration: 0.5s,  0.5s;
}

.switch.right #switch_circle {
    transition-duration: 0.5s,  0.5s;
    left: 20px;
}

.switch.left #switch_circle {
    transition-duration: 0.5s,  0.5s;
}

