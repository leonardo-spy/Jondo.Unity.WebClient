.subTab .unity-radio-button:hover .unity-radio-button__checkmark-background {
    background-image: url("/Assets/UI/Themes/darkStone/common/bg_tab_disabled_over.png");
    height: 100%;
    width: 100%;
    position: relative;
}

.subTab .unity-radio-button:active .unity-radio-button__checkmark-background {
    background-image: url("/Assets/UI/USSTextures/bg_tab_selected_pressed.png");
    height: 100%;
    position: relative;
}

.subTab .unity-radio-button .unity-radio-button__checkmark {
    background-image: url("/Assets/UI/Themes/darkStone/common/bg_tab_selected_normal.png");
    -unity-slice-bottom: -10;
    -unity-slice-left: 8;
    -unity-slice-top: 0;
    -unity-slice-right: 8;
    height: 100%;
    width: 100%;
    padding: 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    position: relative;
}

.subTab .unity-radio-button:hover .unity-radio-button__checkmark {
    background-image: url("/Assets/UI/USSTextures/bg_tab_selected_over.png");
}

.subTab .unity-radio-button .unity-radio-button__input {
    align-content: center;
}

.subTab .unity-base-field__input {
    flex-direction: row;
    justify-content: space-around;
}

.subTab .unity-radio-button .unity-radio-button__text {
    color: var( --radio_button_label_color);
    -unity-font-style: var( --radio_button_label_style);
    height: 100%;
    width: 100%;
    margin: 0;
    padding: 0;
    position: absolute;
    -unity-text-align: middle-center;
    font-size: 14px;
}

.subTab .unity-radio-button:checked {
    --radio_button_label_color: rgb(222, 255, 0);
    --radio_button_label_style: bold;
}

.unity-radio-button:hover {
    --radio_button_label_color: rgb(222, 255, 0);
    --radio_button_label_style: bold;
}

.titleTab .unity-radio-button {
    margin: 0;
    height: 100%;
    flex-grow: 1;
    align-content: center;
    --radio_button_label_color: rgb(210, 210, 210);
    --border-bottom-color: 0;
}

.titleTab .unity-radio-button .unity-radio-button__checkmark-background {
    background-image: none;
    height: 100%;
    width: 100%;
    padding: 0;
    margin: 0;
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    border-width: 0;
}

.titleTab .unity-radio-button .unity-radio-button__checkmark {
    background-image: url("/Assets/UI/Themes/darkStone/common/green_arrow.png");
    height: 10px;
    width: 10px;
    position: absolute;
    bottom: 0;
}

.titleTab .unity-base-field__input {
    flex-direction: row;
    justify-content: space-around;
}

.titleTab .unity-radio-button .unity-radio-button__text {
    color: var( --radio_button_label_color);
    border-bottom-color: var( --border-bottom-color);
    border-bottom-width: 2px;
    -unity-font-style: bold;
    height: 100%;
    width: 100%;
    margin: 0;
    padding: 0;
    position: absolute;
    -unity-text-align: middle-center;
    font-size: 14px;
}

.titleTab .unity-radio-button:checked {
    --radio_button_label_color: rgb(222, 255, 0);
    --border-bottom-color: rgb(222, 255, 0);
}

.titleTab .unity-radio-button:hover {
    --radio_button_label_color: rgb(222, 255, 0);
    --border-bottom-color: rgb(222, 255, 0);
}

