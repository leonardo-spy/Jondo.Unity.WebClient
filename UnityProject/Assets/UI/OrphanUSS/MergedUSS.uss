.window #window_background {
    background-color: var( --background_dark100);
    --shadow: var( --panels_innerShadowsdropShadows);
    border-radius: 12px;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-self: stretch;
    justify-content: space-around;
    overflow: hidden;
}

.opacityLow > #background {
    opacity: 0.5;
}

.opacityMedium > #background {
    opacity: 0.7;
}

.forcedOpacity.opacityLow > #background {
    opacity: 0.6;
}

.forcedOpacity.opacityMedium > #background {
    opacity: 0.8;
}

.forcedOpacity:hover > #background {
    transition-delay: 0s;
    opacity: 1;
}

.window #window_content {
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    overflow: hidden;
}

.SubHeader {
    background-color: var( --background_medium90);
    padding-top: 10px;
    padding-bottom: 10px;
}

.GradientSubHeader {
    background-image: url("/Assets/UI/Themes/Figma/window/tabhighlight.png");
    -unity-background-image-tint-color: var( --background_medium90);
}

.GradientSubHeader.SubHeader {
    background-color: var( --clear);
}

.GradientSubHeader.global_header {
    background-color: var( --clear);
}

.SubHeaderBorder {
    border-bottom-color: rgba(255, 255, 255, 0.15);
    border-bottom-width: 1;
}

.Content {
    min-height: 200px;
}

.Footer {
    background-color: var( --background_medium90);
    padding-top: 10px;
}

.window #window_shadow {
    position: absolute;
    background-image: url("/Assets/UI/Themes/Figma/window/windowShadow.png");
    align-self: stretch;
    left: -29px;
    top: -21px;
    right: -29px;
    bottom: -37px;
    -unity-slice-left: 45;
    -unity-slice-top: 45;
    -unity-slice-right: 45;
    -unity-slice-bottom: 45;
    opacity: 80;
}

.window #window_inner {
    overflow: hidden;
    border-radius: 12px;
    background-color: rgba(0, 0, 0, 0);
    --shadow: "inset 1px 0px rgba(255,255,255,0.1) | inset -1px 0px rgba(0,0,0,0.13) | inset 0px -1px 0px 0px rgba(0,0,0,0.13)";
    position: absolute;
    align-self: stretch;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.window .main {
    background-image: url("/Assets/UI/InlineTextures/cosmeticUi_4_windowInnerShadow.png");
}

.innerShadowContainer {
    background-image: url("/Assets/UI/InlineTextures/cosmeticUi_4_windowInnerShadow.png");
}

