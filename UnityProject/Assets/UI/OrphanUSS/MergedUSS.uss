.block {
    flex-shrink: 0;
    flex-grow: 1;
}

.block__background {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0.5;
    background-image: url("/Assets/UI/USSTextures/block_background_second.png");
}

.block__scratch {
    position: absolute;
    background-image: url("/Assets/UI/USSTextures/block_border_scratch.png");
    -unity-slice-left: 75;
    -unity-slice-top: 66;
    -unity-slice-right: 75;
    -unity-slice-bottom: 66;
    opacity: 0.5;
    width: 100%;
    height: 100%;
}

.block__content {
    padding: 5px;
    flex-shrink: 1;
    flex-grow: 1;
}

.block__border {
    position: absolute;
    background-image: url("/Assets/UI/USSTextures/block_border_double_scratch.png");
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 12;
    opacity: 0.5;
    width: 100%;
    height: 100%;
}

.doubleBlock {
    flex-grow: 1;
    flex-shrink: 0;
}

.doubleBlock__background {
    background-image: url("/Assets/UI/USSTextures/block_background_second.png");
    position: absolute;
    width: 100%;
    height: 100%;
}

.doubleBlock__scratch {
    background-image: url("/Assets/UI/USSTextures/block_border_double_scratch.png");
    -unity-slice-left: 180;
    -unity-slice-top: 125;
    -unity-slice-right: 180;
    -unity-slice-bottom: 200;
    position: absolute;
    width: 100%;
    height: 100%;
}

.doubleBlock__content {
    flex-grow: 1;
    flex-shrink: 1;
}

.doubleBlock__border {
    background-image: url("/Assets/UI/USSTextures/block_border_double_scratch.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 20;
    -unity-slice-top: 20;
    -unity-slice-right: 20;
    -unity-slice-bottom: 20;
    display: flex;
    position: absolute;
    width: 100%;
    height: 100%;
}

.extend-progress-bar {
    padding-bottom: 1px;
    overflow: hidden;
    flex-direction: row;
    justify-content: space-between;
    margin-left: 3px;
    margin-right: 3px;
    margin-top: 1px;
    margin-bottom: 1px;
    align-items: center;
}

.extend-progress-bar__progress {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
}

.extend-progress-bar__background {
    border-width: 1px;
    border-color: rgb(128, 128, 128);
    background-color: rgb(0, 0, 0);
    height: 19px;
    flex: 1 0 0;
    overflow: hidden;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

.extend-progress-bar__label {
    min-width: 100px;
    padding-left: 2px;
    font-size: 12px;
    margin-top: 0;
    margin-bottom: 0;
    margin-right: 2px;
    -unity-text-align: middle-left;
    color: rgb(210, 210, 210);
}

.extend-progress-bar__separatorContainer {
    flex-direction: row;
    flex-grow: 1;
}

.extend-progress-bar__separatorElement {
    width: 2px;
    height: 100%;
    background-color: rgba(55, 55, 55, 0.78);
}

.progressBar__background .extend-progress-bar__background {
    border-width: 0px;
    background-color: rgb(0, 0, 0);
}

.progressBar__greenProgress .extend-progress-bar__progress {
    border-width: 0px;
    background-color: rgb(204, 246, 0);
}

.progressBar__greenYellow .extend-progress-bar__progress {
    border-width: 0px;
    background-color: rgb(252, 200, 0);
}

.progressBar__greenGold .extend-progress-bar__progress {
    border-width: 0px;
    background-color: rgb(255, 234, 0);
}

.progressBar__greenBlue .extend-progress-bar__progress {
    border-width: 0px;
    background-color: rgb(58, 242, 255);
}

.progressBar__xp .extend-progress-bar__progress {
    border-width: 0px;
    background-color: rgb(58, 242, 255);
}

.progressBar__separatorElement .extend-progress-bar__separatorElement {
    background-color: rgb(37, 37, 37);
}

.window {
