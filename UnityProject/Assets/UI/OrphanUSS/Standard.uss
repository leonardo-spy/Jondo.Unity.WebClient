:root {
    --highlight_primary100: rgb(240, 255, 79);
    --highlight_primary80: rgba(240, 255, 79, 0.8);
    --highlight_primary50: rgba(240, 255, 79, 0.5);
    --highlight_primary25: rgba(240, 255, 79, 0.25);
    --highlight_secondary100: rgb(182, 179, 230);
    --highlight_secondary15: rgba(182, 179, 230, 0.15);
    --highlight_secondary25: rgba(182, 179, 230, 0.25);
    --highlight_secondary35: rgba(182, 179, 230, 0.35);
    --highlight_secondary50: rgba(182, 179, 230, 0.5);
    --highlight_secondary65: rgba(182, 179, 230, 0.65);
    --highlight_secondary80: rgba(182, 179, 230, 0.8);
    --buttons_buttonPrimary: rgb(140, 168, 0);
    --buttons_buttonPrimaryHover: rgba(142, 164, 36, 0.8);
    --buttons_buttonPrimaryPressed: rgba(207, 217, 94, 0.8);
    --buttons_buttonSecondary: rgba(45, 48, 83, 0.8);
    --buttons_buttonSecondaryHover: rgba(80, 84, 126, 0.8);
    --buttons_buttonSecondaryPressed: rgba(164, 167, 199, 0.8);
    --background_dark100: rgb(27, 29, 50);
    --background_dark80: rgba(27, 29, 50, 0.8);
    --background_dark95: rgba(27, 29, 50, 0.95);
    --background_medium100: rgb(61, 64, 92);
    --background_medium90: rgba(61, 64, 92, 0.9);
    --header_background: rgba(182, 179, 229, 0.2);
    --header_gradient: rgba(182, 179, 229, 0.8);
    --background_highlight: rgb(114, 117, 217);
    --header_ornament: url("/Assets/UI/Themes/Figma/window/ornaments/ornamentStandard.png");
}

