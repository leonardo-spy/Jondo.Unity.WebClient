#icon_kamas {
    -unity-background-image-tint-color: var( --highlight_primary100);
}

#lbl_price {
    color: var( --highlight_primary100);
}

.cantBuy #icon_kamas {
    -unity-background-image-tint-color: var( --qualitative_lightRed100);
}

.cantBuy #lbl_price {
    color: var( --qualitative_lightRed100);
}

