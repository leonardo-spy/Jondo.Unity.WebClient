.renderstudio-grid-view__item {
    background-color: rgba(204, 204, 204, 0.07);
}

.renderstudio-grid-view__item--alternative-background {
    background-color: rgba(0, 0, 0, 0);
}

.renderstudio-grid-view__item--alternative-background:hover {
    background-color: rgba(204, 204, 204, 0.13);
}

.renderstudio-grid-view__item:hover {
    background-color: rgba(204, 204, 204, 0.13);
}

.renderstudio-grid-view__item--selected {
    background-color: rgba(204, 204, 204, 0.19);
}

.renderstudio-grid-view__item--selected:hover {
    background-color: rgba(204, 204, 204, 0.19);
}

.renderstudio-grid-view .renderstudio-grid-view__item__background VisualElement {
    background-color: rgba(204, 204, 204, 0.07);
}

.renderstudio-grid-view .renderstudio-grid-view__item__background .renderstudio-grid-view__item--alternative-background {
    background-color: rgba(0, 0, 0, 0);
}

