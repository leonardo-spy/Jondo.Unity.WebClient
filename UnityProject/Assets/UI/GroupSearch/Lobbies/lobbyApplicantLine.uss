.lobbyApplicantLine {
    background-color: var( --buttons_buttonSecondary);
}

.lobbyApplicantLine:hover {
    background-color: var( --buttons_buttonSecondaryHover);
}

.lobbyApplicantLine.active {
    background-color: var( --buttons_buttonSecondary);
    border-color: var( --highlight_primary100);
}

.omega > #ctr_levelValue > #tx_omega {
    background-image: url("/Assets/UI/Themes/darkStone/texture/omegaBack.png");
}

.omega > #ctr_levelValue > #lbl_levelValue {
    color: var( --black_black100);
}

.omega > #ctr_levelValue {
    min-width: 38px;
}

